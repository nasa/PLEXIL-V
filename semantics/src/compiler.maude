----                       Compilation of a PLEXIL plan into a set of Processes
----                                                       author: Camilo Rocha

fmod COMPILER is
  protecting PLEXIL .
  protecting LIBRARY .
  protecting FUNPRED .

  *** Function that creates a set of memory processes
  *** from a list of local declarations
  op createLocalVars : Qualified LocalDecls -> Configuration .
  eq createLocalVars(Q,nilocdecl) = none .
  eq createLocalVars(Q,((I : V) LD))
    = < (I . Q) : memory | initVal: V , actVal: V, prevVal: V > createLocalVars(Q,LD) .

  op compile : Plexil -> GlobalConfig .
  eq compile(PL) = compile(PL,emptyEnvGen(30)) .
  op compile : Plexil InputGenerator -> GlobalConfig .
  eq compile(PL,EG)
  = sanitizeIds(
      embedCacheIds(
        stop |
        [ generator : EG                  ]
        [ environment : mtenvironment     ]
        [ nodes : compileNodes(PL,nilq)   ]
        [ memory : compileMemory(PL,nilq) collectLookupCaches(PL,nilq,0) ]
        [ microacts : mtactions           ]
        [ macroacts : mtactions           ]
        [ interface : none                ]
        [ trace : niltrace                ],
        collectCacheMapping(PL,nilq,0)
      )
  )
  .

  *** TODO: Create defaultAttributes and mergeAttributes that encapsulate default attributes and merging of user supply ones
  op compileNodes : Plexil Qualified ~> Configuration .
  eq compileNodes(list(I, LD, (AtS), nil), Q)
  = < (I . Q) : list | defaultAttributes(list, getRepeatCondition(AtS)) / (AtS) > .
  eq compileNodes(list(I, LD, (AtS), (PL PLL)), Q)
    = (compileNodes(PL, (I . Q)) compileNodes(list(I, LD, (AtS), PLL), Q)) .
  eq compileNodes(
      library(I, LD, (AtS),
        callInfo(Callee:Identifier, IDs, Args:Parameters),
        PL),
      Q
    )
    =
    < (I . Q) : library |
      callee: Callee:Identifier,
      parameters: IDs,
      arguments: Args:Parameters,
      defaultAttributes(library, getRepeatCondition(AtS)) / (AtS) >
    compileNodes(PL, (I . Q))
  .
  eq compileNodes(command(I, LD, (AtS), C), Q)
  = < (I . Q) : command |
    command: C,
    defaultAttributes(command,getRepeatCondition(AtS))
      / defaultAttributeEnrichments(I . Q, command,AtS)
    > .
  eq compileNodes(assignment(I, LD, (AtS), (AT := E)), Q)
  = < (I . Q) : assignment | (AT := E), defaultAttributes(assignment, getRepeatCondition(AtS)) / (AtS) > .
  eq compileNodes(update(I, LD, (AtS), PS:List{Pair{Qid,Expression}}), Q)
  = < (I . Q) : update |
    pairs: PS:List{Pair{Qid,Expression}},
    ack: false,
    defaultAttributes(update, getRepeatCondition(AtS))
      / defaultAttributeEnrichments(I . Q, update,AtS)
    > .
  eq compileNodes(empty(I, LD, AtS), Q)
  = < (I . Q) : empty | defaultAttributes(empty,getRepeatCondition(AtS)) / (AtS) > .

  ********************************************************************************
  ***
  *** Sanitize IDs:
  ***
  *** This code changes all ID-references to nodes or variables to their
  *** fully qualified version.
  ***
  op sanitizeIds : GlobalConfig -> GlobalConfig .
  eq sanitizeIds(Op | Conf) = Op | sanitizeIds(Conf) .

  op sanitizeIds : Config -> Config .
  eq sanitizeIds(
      [ nodes  : Cfg  ]
      [ memory : MeM  ] Conf
    )
  =  [ nodes : sanitizeIds(Cfg,Cfg MeM) ]
      [ memory : sanitizeIdsInMemory(MeM, Cfg MeM) ] Conf
  .

  op sanitizeIds : Configuration Configuration -> Configuration .
  eq sanitizeIds( < Q : Cls | AtS > Cfg, Cfg')
  = < Q : Cls | sanitizeIds(AtS, Q, Cfg') > sanitizeIds(Cfg,Cfg') [owise] .
  eq sanitizeIds(none, Cfg') = none [owise] .

  op sanitizeIdsInMemory : Configuration Configuration -> Configuration .
  eq sanitizeIdsInMemory(< cache(N) : lookup-cache | nodeContext: NQ, AtS > MeM, Cfg)
  = < cache(N) : lookup-cache | nodeContext: NQ, sanitizeIdsInCacheAttrs(AtS, NQ, Cfg) > sanitizeIdsInMemory(MeM, Cfg) .
  eq sanitizeIdsInMemory(< Q : Cls | AtS > MeM, Cfg)
  = < Q : Cls | AtS > sanitizeIdsInMemory(MeM, Cfg) [owise] .
  eq sanitizeIdsInMemory(none, Cfg) = none .

  op sanitizeIdsInCacheAttrs : AttributeSet NeQualified Configuration -> AttributeSet .
  eq sanitizeIdsInCacheAttrs((args: Ps, AtS), NQ, Cfg)
  = (args: sanitizeIdsOnParams(Ps, NQ, Cfg), sanitizeIdsInCacheAttrs(AtS, NQ, Cfg)) .
  eq sanitizeIdsInCacheAttrs((stateName: E, AtS), NQ, Cfg)
  = (stateName: sanitizeIds(E, NQ, Cfg), sanitizeIdsInCacheAttrs(AtS, NQ, Cfg)) .
  eq sanitizeIdsInCacheAttrs(AtS, NQ, Cfg) = AtS [owise] .

  op sanitizeIds : AttributeSet NeQualified Configuration -> Attribute .
  eq sanitizeIds((At,AtS), NQ, Cfg) = sanitizeIdsOnAttr(At, NQ, Cfg), sanitizeIds(AtS, NQ, Cfg) .
  eq sanitizeIds(none, NQ, Cfg) = none .

  op sanitizeIdsOnPairs : List{Pair{Qid,Expression}} NeQualified Configuration -> List{Pair{Qid,Expression}} .
  eq sanitizeIdsOnPairs(nil, NQ, Cfg) = nil .
  eq sanitizeIdsOnPairs(< Q ; E > PAIRS, NQ, Cfg)
    =
    < Q ; sanitizeIds(E,NQ,Cfg) > sanitizeIdsOnPairs(PAIRS, NQ, Cfg)
  .

  vars PAIRS : List{Pair{Qid,Expression}} .
  vars Es : Parameters .
  vars VE : VariableExpression .

  op sanitizeIdsOnParams : Parameters NeQualified Configuration -> Parameters .
  eq sanitizeIdsOnParams(E Ps,   NQ, Cfg) = sanitizeIds(E, NQ, Cfg) sanitizeIdsOnParams(Ps, NQ, Cfg) .
  eq sanitizeIdsOnParams(nilpar, NQ, Cfg) = nilpar .

  op  sanitizeIdsOnAttr : Attribute NeQualified Configuration ~> Attribute .
  eq  sanitizeIdsOnAttr((arguments: Es),  NQ, Cfg) = arguments: sanitizeIdsOnParams(Es, NQ, Cfg) .
  eq  sanitizeIdsOnAttr((pairs: PAIRS),  NQ, Cfg) = pairs: sanitizeIdsOnPairs(PAIRS, NQ, Cfg) .
  eq  sanitizeIdsOnAttr((AT := E),  NQ, Cfg) = sanitizeIds(AT, NQ, Cfg) := sanitizeIds(E, NQ, Cfg) .
  eq  sanitizeIdsOnAttr((command: NQ' / Ps / just(Q)), NQ, Cfg) = command: NQ' / sanitizeIdsOnParams(Ps,NQ,Cfg) / just(getFullyQualifiedVariableId(Q, NQ, Cfg)) .
  eq  sanitizeIdsOnAttr((command: NQ' / Ps / nothing), NQ, Cfg) = command: NQ' / sanitizeIdsOnParams(Ps,NQ,Cfg) / nothing .
  eq  sanitizeIdsOnAttr((command: cmdId(VE) / Ps / just(Q)), NQ, Cfg) = command: cmdId(sanitizeIds(VE, NQ, Cfg)) / sanitizeIdsOnParams(Ps,NQ,Cfg) / just(getFullyQualifiedVariableId(Q, NQ, Cfg)) .
  eq  sanitizeIdsOnAttr((command: cmdId(VE) / Ps / nothing), NQ, Cfg) = command: cmdId(sanitizeIds(VE, NQ, Cfg)) / sanitizeIdsOnParams(Ps,NQ,Cfg) / nothing .
  ceq sanitizeIdsOnAttr(At,             NQ, Cfg) = At'
  if
    B := attributeIsSanitizable(At)
    /\ E   := getAttribute(At)
    /\ At' := if B
                then replaceAttribute(At,sanitizeIds(E,NQ,Cfg))
                else At
              fi
  [owise]
  .

    op attributeIsSanitizable : Attribute -> Bool .
    eq attributeIsSanitizable(repeatc: E) = true .
    eq attributeIsSanitizable(startc:  E) = true .
    eq attributeIsSanitizable(endc:    E) = true .
    eq attributeIsSanitizable(exitc:   E) = true .
    eq attributeIsSanitizable(post:    E) = true .
    eq attributeIsSanitizable(skip:    E) = true .
    eq attributeIsSanitizable(pre:     E) = true .
    eq attributeIsSanitizable(inv:     E) = true .
    eq attributeIsSanitizable(At) = false [owise] .

  var Hndl : CommandHandle .
  var Fun  : Function .

  op sanitizeIds : Expression NeQualified Configuration ~> Expression .
  eq sanitizeIds((not E)                            , NQ, Cfg) = not sanitizeIds(E, NQ, Cfg) .
  eq sanitizeIds((E and E')                         , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  and sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E or E')                          , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  or  sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E < E')                           , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  <   sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E <= E')                          , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  <=  sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E > E')                           , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  >   sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E >= E')                          , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  >=  sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E equ E')                         , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  equ sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E nequ E')                        , NQ, Cfg) = sanitizeIds(E, NQ, Cfg) nequ sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E + E')                           , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  +   sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E - E')                           , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  -   sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E * E')                           , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  *   sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E / E')                           , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  /   sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E max E')                         , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  max sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E min E')                         , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  min sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds((E rem E')                         , NQ, Cfg) = sanitizeIds(E, NQ, Cfg)  rem sanitizeIds(E', NQ, Cfg) .
  eq sanitizeIds(cmdHandleIs?(I . Q,Hndl)           , NQ, Cfg) = cmdHandleIs?(getFullyQualifiedNodeId(I, Q . NQ, Cfg), Hndl) .
  eq sanitizeIds(areChildren?(I . Q,Status)         , NQ, Cfg) = areChildren?(getFullyQualifiedNodeId(I, Q . NQ, Cfg), Status) .
  eq sanitizeIds(isFailure?(I . Q,FlTy)             , NQ, Cfg) = isFailure?(getFullyQualifiedNodeId(I, Q . NQ, Cfg), FlTy) .
  eq sanitizeIds(func(Fun,E)                        , NQ, Cfg) = func(Fun,sanitizeIds(E, NQ, Cfg)) .
  eq sanitizeIds(isKnown(E)                         , NQ, Cfg) = isKnown(sanitizeIds(E, NQ, Cfg)) .
  eq sanitizeIds(noChildFailed                      , NQ, Cfg) = noChildFailed(NQ) .
  eq sanitizeIds(isFinished?(sibling(I))            , NQ, Cfg) = isFinished?(getFullyQualifiedNodeId(self,I . tailQualified(NQ),Cfg)) .
  eq sanitizeIds(isFinished?(I)                     , NQ, Cfg) = isFinished?(getFullyQualifiedNodeId(I,NQ,Cfg)) .
  eq sanitizeIds(hasSucceeded?(sibling(I))          , NQ, Cfg) = hasSucceeded?(getFullyQualifiedNodeId(self,I . tailQualified(NQ),Cfg)) .
  eq sanitizeIds(hasSucceeded?(I . Q)               , NQ, Cfg) = hasSucceeded?(getFullyQualifiedNodeId(I . Q,NQ,Cfg)) .
  eq sanitizeIds(hasPostconditionFailed?(sibling(I)), NQ, Cfg) = hasPostconditionFailed?(getFullyQualifiedNodeId(self,I . tailQualified(NQ),Cfg)) .
  eq sanitizeIds(hasPostconditionFailed?(I . Q)     , NQ, Cfg) = hasPostconditionFailed?(getFullyQualifiedNodeId(I . Q,NQ,Cfg)) .
  eq sanitizeIds(hasSkipped?(self)                  , NQ, Cfg) = hasSkipped?(getFullyQualifiedNodeId(self, NQ, Cfg)) .
  eq sanitizeIds(hasSkipped?(sibling(I))            , NQ, Cfg) = hasSkipped?(getFullyQualifiedNodeId(self,I . tailQualified(NQ),Cfg)) .
  eq sanitizeIds(hasSkipped?(I . Q)                 , NQ, Cfg) = hasSkipped?(getFullyQualifiedNodeId(I . Q,NQ,Cfg)) .
  eq sanitizeIds(hasIterationEnded?(sibling(I))     , NQ, Cfg) = hasIterationEnded?(getFullyQualifiedNodeId(self,I . tailQualified(NQ),Cfg)) .
  eq sanitizeIds(hasIterationEnded?(I . Q)          , NQ, Cfg) = hasIterationEnded?(getFullyQualifiedNodeId(I . Q,NQ,Cfg)) .
  eq sanitizeIds(isStatus?(I . Q,Status)            , NQ, Cfg) = isStatus?(getFullyQualifiedNodeId(I, Q . NQ, Cfg), Status) .
  eq sanitizeIds(isOutcome?(I . Q,Out)              , NQ, Cfg) = isOutcome?(getFullyQualifiedNodeId(I, Q . NQ, Cfg), Out) .
  eq sanitizeIds(isOutcomeFailure?(I . Q)           , NQ, Cfg) = isOutcomeFailure?(getFullyQualifiedNodeId(I, Q . NQ, Cfg)) .
  eq sanitizeIds(hasRcvAck?(self)                   , NQ, Cfg) = hasRcvAck?(getFullyQualifiedNodeId(self, NQ, Cfg)) .
  eq sanitizeIds(hasRcvAck?(I . Q)                  , NQ, Cfg) = hasRcvAck?(getFullyQualifiedNodeId(self, I . Q . NQ, Cfg)) .
  eq sanitizeIds(var(I . Q)                         , NQ, Cfg) = var(getFullyQualifiedVariableId(I, Q . NQ, Cfg)) .
  eq sanitizeIds(arrayVar(I . Q,E)                  , NQ, Cfg) = arrayVar(getFullyQualifiedVariableId(I, Q . NQ, Cfg), sanitizeIds(E, NQ, Cfg)) .
  eq sanitizeIds(arrayVar(I . Q)                    , NQ, Cfg) = arrayVar(getFullyQualifiedVariableId(I, Q . NQ, Cfg)) .
  eq sanitizeIds(const(varForwarding(I . Q))        , NQ, Cfg) = const(varForwarding(getFullyQualifiedVariableId(I, Q . NQ, Cfg))) .
  eq sanitizeIds(const(V)                           , NQ, Cfg) = const(V) [owise] .
  eq sanitizeIds(lookup(I,Params)                   , NQ, Cfg) = lookup(I,sanitizeIdsOnParams(Params,NQ,Cfg)) .
  eq sanitizeIds(lookup(VE,Params)                  , NQ, Cfg) = lookup(sanitizeIds(VE,NQ,Cfg),sanitizeIdsOnParams(Params,NQ,Cfg)) .
  eq sanitizeIds(lookupOnChange(I,Params,V)         , NQ, Cfg) = lookupOnChange(I,sanitizeIdsOnParams(Params,NQ,Cfg),V) .
  eq sanitizeIds(lookupOnChange(VE,Params,V)        , NQ, Cfg) = lookupOnChange(sanitizeIds(VE,NQ,Cfg),sanitizeIdsOnParams(Params,NQ,Cfg),V) .
  eq sanitizeIds(lookupOnChange(N,I,Params,V)       , NQ, Cfg) = lookupOnChange(N,I,sanitizeIdsOnParams(Params,NQ,Cfg),V) .
  eq sanitizeIds(lookupOnChange(N,VE,Params,V)      , NQ, Cfg) = lookupOnChange(N,sanitizeIds(VE,NQ,Cfg),sanitizeIdsOnParams(Params,NQ,Cfg),V) .
  eq sanitizeIds(timepoint(I . Q, Status, Timepoint), NQ, Cfg) = timepoint(getFullyQualifiedNodeId(I, Q . NQ, Cfg), Status, Timepoint) .

  ceq sanitizeIds(E, NQ, Cfg) = Err:[Expression]
  if Err:[Expression] := ERROR{sanitizeIds.Expression: E}
  [owise print Err:[Expression]] .

  op ERROR{sanitizeIds.Expression:_} : [Expression] -> [Expression] [ctor] .


  ********************************************************************************
  ***
  *** Fully Qualified Id
  ***
  *** - getFullyQualifiedNodeId
  *** - getFullyQualifiedVariableId
  ***
  op unresolvedNode     : Identifier Qualified     -> [Identifier] .
  op unresolvedVariable : Identifier Qualified     -> [Identifier] .
  op ambiguity          : Qualified  Configuration -> [Identifier] .

  op  getFullyQualifiedNodeId : Identifier Qualified Configuration -> Qualified .
  ceq getFullyQualifiedNodeId(I, Q, Cfg) = ambiguity(Q',Cfg)
    if < Q' : Cls | AtS > < Q' : Cls' | AtS' > Cfg' := Cfg  . *** NOTE: This detects ambiguities
  eq  getFullyQualifiedNodeId(I, Q, Cfg) = getFullyQualifiedNodeId'(I,Q,Cfg,Q) [owise] .

    op getFullyQualifiedNodeId' : Identifier Qualified Configuration Qualified -> Qualified .
    eq getFullyQualifiedNodeId'(self,      Q,                        Cfg, Q') = Q' .
    eq getFullyQualifiedNodeId'(I   ,   nilq, < I      : Cls | AtS > Cfg, Q') = I [owise] .
    eq getFullyQualifiedNodeId'(I   ,      I, < I      : Cls | AtS > Cfg, Q') = I [owise] .
    eq getFullyQualifiedNodeId'(I   ,     NQ, < I . NQ : Cls | AtS > Cfg, Q') = (I . NQ) [owise] .
    eq getFullyQualifiedNodeId'(I   , I' . Q,                        Cfg, Q') = getFullyQualifiedNodeId'(I, Q, Cfg, Q') [owise] .
    eq getFullyQualifiedNodeId'(I   ,      Q,                        Cfg, Q') = unresolvedNode(I,Q') [owise] .


  op getFullyQualifiedVariableId : Qualified Qualified Configuration -> Qualified .
  eq getFullyQualifiedVariableId(nilq  , Q, Cfg) = nilq .
  eq getFullyQualifiedVariableId(I . NQ, Q, Cfg) = getFullyQualifiedVariableId(I, NQ . Q, Cfg) .
  eq getFullyQualifiedVariableId(child(NQ), Q, Cfg) = getFullyQualifiedVariableId(NQ, Q, Cfg) .
  eq getFullyQualifiedVariableId(I . Q', Q, Cfg) = getFullyQualifiedVariableId(I, Q, Cfg) [owise] .

  op getFullyQualifiedVariableId : Identifier Qualified Configuration -> Qualified .
  eq getFullyQualifiedVariableId(I,Q,Cfg) = getFullyQualifiedVariableId'(I,Q,Cfg,Q) .

    op getFullyQualifiedVariableId' : Identifier Qualified Configuration Qualified -> Qualified .
    eq getFullyQualifiedVariableId'(I, nilq  , < I      : memory | AtS > Cfg, Q') = I .
    eq getFullyQualifiedVariableId'(I, NQ    , < I . NQ : memory | AtS > Cfg, Q') = (I . NQ) .
    eq getFullyQualifiedVariableId'(I, I' . Q,                           Cfg, Q') = getFullyQualifiedVariableId'(I,Q,Cfg,Q') [owise] .
    eq getFullyQualifiedVariableId'(I, Q     ,                           Cfg, Q') = unresolvedVariable(I,Q') [owise] .


  op toLocalDeclsWithUndefined : Identifiers ~> LocalDecls .
  eq toLocalDeclsWithUndefined(ids(nilq)) = nilocdecl .
  eq toLocalDeclsWithUndefined(ids(I . IS)) = (I : unknown) toLocalDeclsWithUndefined(ids(IS)) .

  op compileMemory : Plexil Qualified ~> Configuration .
  eq compileMemory(
      library(I,
        LD,
        AtS,
        callInfo(Callee:Identifier, IDs, Args:Parameters),
        PL
      ),
      Q
    )
    = createLocalVars((I . Q), LD) compileMemory(PL, (I . Q)) .
  eq compileMemory(list(I, LD, (AtS), nil), Q)
  = createLocalVars((I . Q), LD) .
  eq compileMemory(list(I, LD, (AtS), (PL PLL)), Q)
  = (compileMemory(PL, (I . Q)) compileMemory(list(I, LD, (AtS), PLL), Q)) .
  eq compileMemory(command(I, LD, (AtS), C), Q)
  = createLocalVars((I . Q),LD) .
  eq compileMemory(retCommand(I, LD, (AtS), Q', Q'', C), Q)
  = createLocalVars((I . Q),LD) .
  eq compileMemory(assignment(I, LD, (AtS), AtS'), Q)
  = createLocalVars((I . Q), LD) .
  eq compileMemory(empty(I, LD, AtS), Q)
  = createLocalVars((I . Q),LD) .
  eq compileMemory(update(I, LD, (AtS), PS:List{Pair{Qid,Expression}}), Q)
  = createLocalVars((I . Q),LD) .

  --- equations for initializing by-default condition expressions and
  --- by-default initial values for variables
  ---- by-default expressions common for all node types

  op default : -> Bool .

  eq < NQ : Cd | startc: default, AtS >
    = < NQ : Cd | startc: const(val(true)), AtS > .
  eq < NQ : Cd | skip: default, AtS >
    = < NQ : Cd | skip: const(val(false)), AtS > .
  eq < NQ : Cd | pre: default, AtS >
    = < NQ : Cd | pre: const(val(true)), AtS > .
  eq < NQ : Cd | inv: default, AtS >
    = < NQ : Cd | inv: const(val(true)), AtS > .
  eq < NQ : Cd | exitc: default, AtS >
    = < NQ : Cd | exitc: const(val(false)), AtS > .
  eq < NQ : Cd | repeatc: default, AtS >
    = < NQ : Cd | repeatc: const(val(false)), AtS > .
  eq < NQ : Cd | post: default, AtS >
    = < NQ : Cd | post: const(val(true)), AtS > .
  ---- by-default expressions for each node type
  --- TODO: Improve the default conditions management so that is not necessary to do top-level matching
  eq < NQ : empty | endc: default, AtS >
    = < NQ : empty | endc: const(val(true)), AtS > .
  ceq < NQ : Cls | endc: default, AtS >
    = < NQ : Cls | endc: areChildren?(self,finished), AtS >
  if (Cls == list) or (Cls == library)
  .
  eq < NQ : command | endc: default, AtS >
    = < NQ : command | endc: const(val(true)), AtS > .  --- TODO this needs revision and be dealt with once the semantics of commands is completed
  eq < NQ : assignment | endc: default, AtS >
    = < NQ : assignment | endc: const(val(true)), AtS > .
  *** TODO: Do it!
  eq < NQ : update | endc: default, AtS >
   = < NQ : update | endc: hasRcvAck?(self), AtS > .

  --- uninitialized variables of types Boolean, Integer, Real, and String
  --- are given the value Unknown

  vars Args Args'     : Arguments .
  vars AT AT'         : AssignmentTarget .
  vars At At'         : Attribute .
  vars AtS AtS'       : AttributeSet .
  vars B B'           : Bool .
  vars Bl             : Bool .
  vars C C'           : Command .
  vars Cd Cls Cls'    : Cid .
  vars Cfg Cfg'       : Configuration .
  vars CL             : EnvironmentList .
  vars Conf           : Config .
  vars E E'           : Expression .
  vars EG EG'         : InputGenerator .
  vars EL EL'         : EnvironmentList .
  vars Env Env'       : Environment .
  vars FlTy FlTy'     : FailureType .
  vars GAMMA          : Environment .
  vars GCfg           : GlobalConfig .
  vars I I'           : Identifier .
  vars IDs            : Identifiers .
  vars IS             : Qualified .
  vars LD LD'         : LocalDecls .
  vars MeM MeM'       : Configuration .
  vars NQ NQ'         : NeQualified .
  vars Op             : Operation .
  vars Out Out'       : Outcome .
  vars Pgm            : Plexil .
  vars PL             : Plexil .
  vars PLL            : PrePlexilList .
  vars Ps Params      : Parameters .
  vars Pairs          : List{Pair{Qid,Expression}} .
  vars Q Q' Q''       : Qualified .
  vars Soup Soup'     : Config .
  vars Status Status' : Status .
  vars Timepoint      : Timepoint .
  vars V V'           : Value .
  vars N N' M         : Nat .
  vars F              : Function .

  ********************************************************************************
  ***
  *** LookupOnChange Cache Collection
  ***
  *** Collect all lookupOnChange expressions and create cache objects
  ***

  --- Collect cache objects from plan
  op collectLookupCaches : Plexil Qualified Nat -> Configuration .
  eq collectLookupCaches(list(I, LD, (AtS), nil), Q, N)
   = collectCachesFromAttrs(AtS, I . Q, N) .
  eq collectLookupCaches(list(I, LD, (AtS), (PL PLL)), Q, N)
   = collectCachesFromAttrs(AtS, I . Q, N)
     collectLookupCaches(PL, (I . Q), nextCacheId(AtS, N))
     collectLookupCachesFromChildren(PLL, I, LD, Q, nextCacheId(AtS, N) + countCachesInPlexil(PL)) .

    --- Helper to collect caches from remaining children without re-processing parent attributes
    op collectLookupCachesFromChildren : PlexilList Identifier LocalDecls Qualified Nat -> Configuration .
    eq collectLookupCachesFromChildren(nil, I, LD, Q, N) = none .
    eq collectLookupCachesFromChildren((PL PLL), I, LD, Q, N)
     = collectLookupCaches(PL, (I . Q), N)
       collectLookupCachesFromChildren(PLL, I, LD, Q, N + countCachesInPlexil(PL)) .

  eq collectLookupCaches(library(I, LD, (AtS), callInfo(Callee:Identifier, IDs, Args:Parameters), PL), Q, N)
   = collectCachesFromAttrs(AtS, I . Q, N)
     collectLookupCaches(PL, (I . Q), nextCacheId(AtS, N)) .
  eq collectLookupCaches(command(I, LD, (AtS), C), Q, N)
   = collectCachesFromAttrs(AtS, I . Q, N) .
  eq collectLookupCaches(assignment(I, LD, (AtS), AT := E), Q, N)
   = collectCachesFromAttrs(AtS, I . Q, N)
     collectCachesFromExpr(E, I . Q, N + countCachesInAttrs(AtS)) .
  eq collectLookupCaches(update(I, LD, (AtS), PS:List{Pair{Qid,Expression}}), Q, N)
   = collectCachesFromAttrs(AtS, I . Q, N)
     collectCachesFromPairs(PS:List{Pair{Qid,Expression}}, I . Q, N + countCachesInAttrs(AtS)) .
  eq collectLookupCaches(empty(I, LD, AtS), Q, N)
   = collectCachesFromAttrs(AtS, I . Q, N) .

  --- Collect from attribute set (conditions)
  op collectCachesFromAttrs : AttributeSet NeQualified Nat -> Configuration .
  eq collectCachesFromAttrs((repeatc: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs((startc: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs((endc: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs((exitc: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs((post: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs((skip: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs((pre: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs((inv: E, AtS), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromAttrs(AtS, NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromAttrs(AtS, NQ, N) = none [owise] .

  --- Collect from expression
  op collectCachesFromExpr : Expression NeQualified Nat -> Configuration .
  --- Constant lookup name (NeQualified) - convert to string constant expression
  --- Depth-first numbering: nested caches get lower IDs, outer caches get higher IDs
  eq collectCachesFromExpr(lookupOnChange(Q, Params, V), NQ, N)
   = collectCachesFromParams(Params, NQ, N)
     < cache(N + countCachesInParams(Params)) : lookup-cache |
       stateName: const(val(string(Q))),
       prevStateName: unknown,
       args: Params,
       prevArgs: nilarg,
       tolerance: V,
       cachedValue: unknown,
       nodeContext: NQ > .
  --- Variable lookup name (VariableExpression) - store variable directly
  eq collectCachesFromExpr(lookupOnChange(VE:VariableExpression, Params, V), NQ, N)
   = collectCachesFromParams(Params, NQ, N)
     < cache(N + countCachesInParams(Params)) : lookup-cache |
       stateName: VE:VariableExpression,
       prevStateName: unknown,
       args: Params,
       prevArgs: nilarg,
       tolerance: V,
       cachedValue: unknown,
       nodeContext: NQ > .
  op collectCachesFromParams : Parameters NeQualified Nat -> Configuration .
  eq collectCachesFromParams(nilpar, NQ, N) = none .
  eq collectCachesFromParams((E Params), NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromParams(Params, NQ, N + countCachesInExpr(E)) .

  eq collectCachesFromExpr(E + E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E - E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E * E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E / E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E rem E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E max E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E min E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E < E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E > E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E <= E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E >= E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E equ E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E nequ E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E and E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(E or E', NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromExpr(E', NQ, N + countCachesInExpr(E)) .
  eq collectCachesFromExpr(not E, NQ, N)
   = collectCachesFromExpr(E, NQ, N) .
  eq collectCachesFromExpr(isKnown(E), NQ, N)
   = collectCachesFromExpr(E, NQ, N) .
  eq collectCachesFromExpr(func(F:Function, E), NQ, N)
   = collectCachesFromExpr(E, NQ, N) .
  eq collectCachesFromExpr(E, NQ, N) = none [owise] .

  --- Collect from pairs
  op collectCachesFromPairs : List{Pair{Qid,Expression}} NeQualified Nat -> Configuration .
  eq collectCachesFromPairs(nil, NQ, N) = none .
  eq collectCachesFromPairs(< Q ; E > PAIRS, NQ, N)
   = collectCachesFromExpr(E, NQ, N) collectCachesFromPairs(PAIRS, NQ, N + countCachesInExpr(E)) .

  --- Count caches in various structures (for ID assignment)
  op countCachesInExpr : Expression -> Nat .
  eq countCachesInExpr(lookupOnChange(Q, Params, V)) = 1 + countCachesInParams(Params) .
  eq countCachesInExpr(lookupOnChange(VE:VariableExpression, Params, V)) = 1 + countCachesInParams(Params) .
  eq countCachesInExpr(E + E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E - E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E * E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E / E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E rem E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E max E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E min E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E < E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E > E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E <= E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E >= E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E equ E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E nequ E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E and E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(E or E') = countCachesInExpr(E) + countCachesInExpr(E') .
  eq countCachesInExpr(not E) = countCachesInExpr(E) .
  eq countCachesInExpr(isKnown(E)) = countCachesInExpr(E) .
  eq countCachesInExpr(func(F:Function, E)) = countCachesInExpr(E) .
  eq countCachesInExpr(E) = 0 [owise] .

  op countCachesInAttrs : AttributeSet -> Nat .
  eq countCachesInAttrs((repeatc: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs((startc: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs((endc: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs((exitc: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs((post: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs((skip: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs((pre: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs((inv: E, AtS)) = countCachesInExpr(E) + countCachesInAttrs(AtS) .
  eq countCachesInAttrs(AtS) = 0 [owise] .

  op countCachesInPlexil : Plexil -> Nat .
  eq countCachesInPlexil(list(I, LD, (AtS), nil)) = countCachesInAttrs(AtS) .
  eq countCachesInPlexil(list(I, LD, (AtS), (PL PLL)))
   = countCachesInAttrs(AtS) + countCachesInPlexil(PL) + countCachesInPlexil(list(I, LD, (AtS), PLL)) .
  eq countCachesInPlexil(library(I, LD, (AtS), callInfo(Callee:Identifier, IDs, Args:Parameters), PL))
   = countCachesInAttrs(AtS) + countCachesInPlexil(PL) .
  eq countCachesInPlexil(command(I, LD, (AtS), C)) = countCachesInAttrs(AtS) .
  eq countCachesInPlexil(assignment(I, LD, (AtS), AT := E))
   = countCachesInAttrs(AtS) + countCachesInExpr(E) .
  eq countCachesInPlexil(update(I, LD, (AtS), PS:List{Pair{Qid,Expression}}))
   = countCachesInAttrs(AtS) + countCachesInPairs(PS:List{Pair{Qid,Expression}}) .
  eq countCachesInPlexil(empty(I, LD, AtS)) = countCachesInAttrs(AtS) .

  op countCachesInPairs : List{Pair{Qid,Expression}} -> Nat .
  eq countCachesInPairs(nil) = 0 .
  eq countCachesInPairs(< Q ; E > PAIRS) = countCachesInExpr(E) + countCachesInPairs(PAIRS) .

  op countCachesInParams : Parameters -> Nat .
  eq countCachesInParams(nilpar) = 0 .
  eq countCachesInParams((E Params)) = countCachesInExpr(E) + countCachesInParams(Params) .

  op nextCacheId : AttributeSet Nat -> Nat .
  eq nextCacheId(AtS, N) = N + countCachesInAttrs(AtS) .

  --- Collect mapping for embedding cache IDs (simplified - return counter)
  op collectCacheMapping : Plexil Qualified Nat -> Nat .
  eq collectCacheMapping(PL, Q, N) = countCachesInPlexil(PL) .

  --- Embed cache IDs into expressions
  op embedCacheIds : GlobalConfig Nat -> GlobalConfig .
  eq embedCacheIds(Op | Conf, N) = Op | embedCacheIdsInConfig(Conf, 0) .

  op embedCacheIdsInConfig : Config Nat -> Config .
  eq embedCacheIdsInConfig([ nodes : Cfg ] Conf, N)
   = [ nodes : embedCacheIdsInNodes(Cfg, N) ] embedCacheIdsInConfig(Conf, N + countCachesInConfig(Cfg)) .
  eq embedCacheIdsInConfig([ memory : Cfg ] Conf, N)
   = [ memory : embedCacheIdsInMemory(Cfg, 0) ] embedCacheIdsInConfig(Conf, N) .
  eq embedCacheIdsInConfig(Conf, N) = Conf [owise] .

  op embedCacheIdsInNodes : Configuration Nat -> Configuration .
  eq embedCacheIdsInNodes(< Q : Cd | AtS > Cfg, N)
   = < Q : Cd | embedCacheIdsInAttrs(AtS, N) > embedCacheIdsInNodes(Cfg, N + countCachesInAttrs(AtS)) .
  eq embedCacheIdsInNodes(none, N) = none .

  op embedCacheIdsInMemory : Configuration Nat -> Configuration .
  --- Depth-first numbering: cache(N') has nested caches at IDs [N' - count, N' - 1]
  --- So we embed starting from N' - countCachesInParams(Params)
  eq embedCacheIdsInMemory(< cache(N') : lookup-cache | args: Params, AtS > Cfg, N)
   = < cache(N') : lookup-cache | args: embedCacheIdsInParams(Params, N' - countCachesInParams(Params)), AtS > embedCacheIdsInMemory(Cfg, N + 1 + countCachesInParams(Params)) .
  eq embedCacheIdsInMemory(< Q : Cd | AtS > Cfg, N)
   = < Q : Cd | AtS > embedCacheIdsInMemory(Cfg, N) .
  eq embedCacheIdsInMemory(none, N) = none .

  op embedCacheIdsInParams : Parameters Nat -> Parameters .
  eq embedCacheIdsInParams(nilpar, N) = nilpar .
  eq embedCacheIdsInParams((E Params), N)
   = (embedCacheIdsInExpr(E, N) embedCacheIdsInParams(Params, N + countCachesInExpr(E))) .

  op embedCacheIdsInAttrs : AttributeSet Nat -> AttributeSet .
  eq embedCacheIdsInAttrs((repeatc: E, AtS), N)
   = (repeatc: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((startc: E, AtS), N)
   = (startc: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((endc: E, AtS), N)
   = (endc: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((exitc: E, AtS), N)
   = (exitc: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((post: E, AtS), N)
   = (post: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((skip: E, AtS), N)
   = (skip: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((pre: E, AtS), N)
   = (pre: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((inv: E, AtS), N)
   = (inv: embedCacheIdsInExpr(E, N), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs(((AT := E), AtS), N)
   = ((AT := embedCacheIdsInExpr(E, N)), embedCacheIdsInAttrs(AtS, N + countCachesInExpr(E))) .
  eq embedCacheIdsInAttrs((pairs: PAIRS, AtS), N)
   = (pairs: embedCacheIdsInPairs(PAIRS, N), embedCacheIdsInAttrs(AtS, N + countCachesInPairs(PAIRS))) .
  eq embedCacheIdsInAttrs(AtS, N) = AtS [owise] .

  op embedCacheIdsInExpr : Expression Nat -> Expression .
  --- Depth-first numbering: nested caches get lower IDs, outer caches get higher IDs
  --- This ensures that when updating caches in order 0→N, dependencies are satisfied
  eq embedCacheIdsInExpr(lookupOnChange(Q, Params, V), N)
   = lookupOnChange(N + countCachesInParams(Params), Q, embedCacheIdsInParams(Params, N), V) .
  eq embedCacheIdsInExpr(lookupOnChange(VE:VariableExpression, Params, V), N)
   = lookupOnChange(N + countCachesInParams(Params), VE:VariableExpression, embedCacheIdsInParams(Params, N), V) .
  eq embedCacheIdsInExpr(E + E', N)
   = embedCacheIdsInExpr(E, N) + embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E - E', N)
   = embedCacheIdsInExpr(E, N) - embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E * E', N)
   = embedCacheIdsInExpr(E, N) * embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E / E', N)
   = embedCacheIdsInExpr(E, N) / embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E rem E', N)
   = embedCacheIdsInExpr(E, N) rem embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E max E', N)
   = embedCacheIdsInExpr(E, N) max embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E min E', N)
   = embedCacheIdsInExpr(E, N) min embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E < E', N)
   = embedCacheIdsInExpr(E, N) < embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E > E', N)
   = embedCacheIdsInExpr(E, N) > embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E <= E', N)
   = embedCacheIdsInExpr(E, N) <= embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E >= E', N)
   = embedCacheIdsInExpr(E, N) >= embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E equ E', N)
   = embedCacheIdsInExpr(E, N) equ embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E nequ E', N)
   = embedCacheIdsInExpr(E, N) nequ embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E and E', N)
   = embedCacheIdsInExpr(E, N) and embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(E or E', N)
   = embedCacheIdsInExpr(E, N) or embedCacheIdsInExpr(E', N + countCachesInExpr(E)) .
  eq embedCacheIdsInExpr(not E, N)
   = not embedCacheIdsInExpr(E, N) .
  eq embedCacheIdsInExpr(isKnown(E), N)
   = isKnown(embedCacheIdsInExpr(E, N)) .
  eq embedCacheIdsInExpr(func(F, E), N)
   = func(F, embedCacheIdsInExpr(E, N)) .
  eq embedCacheIdsInExpr(E, N) = E [owise] .

  op embedCacheIdsInPairs : List{Pair{Qid,Expression}} Nat -> List{Pair{Qid,Expression}} .
  eq embedCacheIdsInPairs(nil, N) = nil .
  eq embedCacheIdsInPairs(< Q ; E > PAIRS, N)
   = < Q ; embedCacheIdsInExpr(E, N) > embedCacheIdsInPairs(PAIRS, N + countCachesInExpr(E)) .

  op countCachesInConfig : Configuration -> Nat .
  eq countCachesInConfig(< Q : Cd | AtS > Cfg)
   = countCachesInAttrs(AtS) + countCachesInConfig(Cfg) .
  eq countCachesInConfig(none) = 0 .

endfm
