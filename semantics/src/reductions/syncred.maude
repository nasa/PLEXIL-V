----                                                     Synchronous reductions
----                                                       author: Camilo Rocha

fmod SYNC-REDUCTION is

protecting FUNPRED .

sort LogMode .
op log   : -> LogMode [ctor] . --- use the print attribute to log
op nolog : -> LogMode [ctor] . --- do not print anything

vars M            : LogMode .
vars AS           : ActionSet .
vars NA AtS AtS'  : AttributeSet .
vars CC           : Cid .
vars Conf         : Config .
vars PS PS'       : Configuration .
vars E            : Expression .
vars ENV          : EnvironmentList .
vars I            : Identifier .
vars N            : Nat .
vars O O'         : Outcome .
vars Pairs        : List{Pair{Qid,Expression}} .
vars PArr PArr'   : PrimitiveArray .
vars Q Q' Q''     : NeQualified .
vars Target       : NeQualified .
vars QID          : Qid .
vars S S'         : Status .
vars Tps          : Timepoints .
vars V V' V''     : Value .

op applyActions : LogMode Config ~> Config .
eq applyActions(M, Conf) = performAssignments(applyActions'(M, Conf)) .


op createOrUpdateVarForwarding : Qualified Qualified Config ~> Config .
eq createOrUpdateVarForwarding(Q, Target, [ memory : < Q : memory |                            AtS > PS ] Conf)
 =                                        [ memory : < Q : memory-forwarding | target: Target      > PS ] Conf .
eq createOrUpdateVarForwarding(Q, Target, [ memory : < Q : memory-forwarding | target: Q',     AtS > PS ] Conf)
 =                                        [ memory : < Q : memory-forwarding | target: Target, AtS > PS ] Conf .
eq createOrUpdateVarForwarding(Q, Target, [ memory :                                            PS ] Conf)
 =                                        [ memory : < Q : memory-forwarding | target: Target > PS ] Conf [owise] .

--- TODO: In and InOut variable arguments are both forwarded, so the library body can
--- assign to an In parameter. The Executive rejects it before execution: plexilc fails with
--- `Variable "foo" is declared In`, and the XML parser wraps In variables in a read-only
--- Alias (xml-parser/parseNode.cc, linkInVar). Reject it in the transpiler using the
--- Interface of the library (plx2maude), not here: this module does not see In/InOut.
op passParameters : Qualified List{Pair{Qid,Expression}} Config ~> Config .
eq passParameters(Q, nil, Conf) = Conf .
eq passParameters(Q, < QID ; const(varForwarding(Q')) > Pairs,                                           Conf)
 = passParameters(Q,                                    Pairs, createOrUpdateVarForwarding(QID . Q, Q', Conf)) .
eq passParameters(Q, < QID ; E > Pairs, [ memory : < QID . Q : memory | actVal:           V, prevVal: V'         , AtS > PS ] Conf) =
   passParameters(Q,             Pairs, [ memory : < QID . Q : memory | actVal: expToVal(E), prevVal: expToVal(E), AtS > PS ] Conf)
[owise]
.

op currentTime : EnvironmentList Configuration ~> Value .
eq currentTime(ENV, PS) = expToVal(eval(ENV, PS, lookup('time, nilpar))) .

op applySetStatus : LogMode Object Status Value ~> Object .
eq applySetStatus(nolog, < Q : CC | status: S, timepoints: Tps, AtS >, S', V)
 = < Q : CC | status: S', timepoints: updateTimepoint(updateTimepoint(Tps, S, end, V), S', start, V), AtS > .
eq applySetStatus(log, < Q : CC | status: S, AtS >, S', V)
 = applySetStatus(nolog, < Q : CC | status: S, AtS >, S', V) [print "    " Q " from " S " to " S'] .

op applyActions' : LogMode Config -> Config .
eq applyActions'(M,
                 [ nodes : < Q : library | callee: Callee:Identifier, AtS > PS ]
                 [ microacts : callLibrary(Q, Pairs),AS ]
                 Conf )
 = applyActions'(M,
                 passParameters(Callee:Identifier . Q,
                                Pairs,
                                [ nodes : < Q : library | callee: Callee:Identifier, AtS > PS ]
                                [ microacts : AS ]
                                Conf) ) .
eq applyActions'(M, [ nodes : < Q : CC | status: S, AtS > PS ]
                    [ environment : ENV ]
                    [ microacts : setStatus(Q,S'),AS ]
                    Conf )
 = applyActions'(M, [ nodes : applySetStatus(M,
                                             < Q : CC | status: S, AtS >,
                                             S',
                                             currentTime(ENV, < Q : CC | status: S, AtS > PS)) PS ]
                    [ environment : ENV ]
                    [ microacts : AS ]
                    Conf ) .
eq applyActions'(M, [ nodes : < Q : CC | outcome: O, AtS > PS ]
                    [ microacts : setOutcome(Q,O'),AS ]
                    Conf )
 = applyActions'(M, [ nodes : < Q : CC | outcome: O', AtS > PS ]
                    [ microacts : AS ]
                    Conf ) .
eq applyActions'(M, [ nodes : < Q : command | outcome: O, AtS > PS ]
                    [ interface : < I . Q : command-on-execution | AtS' > PS' ]
                    [ microacts : resetNode(Q),AS ]
                    Conf )
 = applyActions'(M, [ nodes : < Q : command | outcome: none, AtS > PS ]
                    [ interface : PS' ]
                    [ microacts : AS ]
                    Conf ) .
eq applyActions'(M, [ nodes : < Q : CC | outcome: O, AtS > PS ]
                    [ microacts : resetNode(Q),AS ]
                    Conf )
 = applyActions'(M, [ nodes : < Q : CC | outcome: none, AtS > PS ]
                    [ microacts : AS ]
                    Conf ) [owise] .
eq applyActions'(M, Conf) = Conf [owise] .


  op performAssignments : Config -> Config .
  eq performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V,  prevVal: V', AtS > PS ]
      [ microacts : undoMem(Q), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V', prevVal: V, AtS > PS ]
      [ microacts : AS ]
      )
    .
  eq performAssignments(
      Conf
      [ memory : < Q : memory | actVal: array(PArr), prevVal: V'', AtS > PS ]
      [ microacts : setMem(Q,array(PArr'),nothing), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q : memory | actVal: assign(PArr, PArr'), prevVal: array(PArr), AtS > PS ]
      [ microacts : AS ]
      )
    .
 eq performAssignments(
     Conf
     [ memory : < Q : memory | actVal: array(PArr), prevVal: V'', AtS > PS ]
     [ microacts : setMem(Q,unknown,nothing), AS ]
     )
 =
   performAssignments(
     Conf
     [ memory : < Q : memory | actVal: unknownArray(length(PArr)), prevVal: array(PArr), AtS > PS ]
     [ microacts : AS ]
     )
   .
  eq performAssignments(
      Conf
      [ memory : < Q  : memory-forwarding | target: Q',  AtS  >
                 < Q' : memory-forwarding | target: Q'', AtS  > PS ]
      [ microacts : setMem(Q,V,nothing), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q  : memory-forwarding | target: Q',  AtS  >
                 < Q' : memory-forwarding | target: Q'', AtS  > PS ]
      [ microacts : setMem(Q',V,nothing), AS ]
      )
    [owise] .
  eq performAssignments(
      Conf
      [ memory : < Q  : memory-forwarding | target: Q',               AtS  >
                 < Q' : memory            | actVal: V', prevVal: V'', AtS' > PS ]
      [ microacts : setMem(Q,V,nothing), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q  : memory-forwarding | target: Q',             AtS  >
                 < Q' : memory            | actVal: V, prevVal: V', AtS' > PS ]
      [ microacts : AS ]
      )
    [owise] .
  eq performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V', prevVal: V'', AtS > PS ]
      [ microacts : setMem(Q,V,nothing), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V, prevVal: V', AtS > PS ]
      [ microacts : AS ]
      )
    [owise] .
  eq performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V', prevVal: V'', AtS > PS ]
      [ microacts : setMem(Q,V,just(val(N))), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q : memory | actVal: updateArray(V',N,V), prevVal: V', AtS > PS ]
      [ microacts : AS ]
      )
    .
  eq performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V', prevVal: V'', AtS > PS ]
      [ microacts : setMem(Q,V,just(unknown)), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q : memory | actVal: unknown, prevVal: V', AtS > PS ]
      [ microacts : AS ]
      )
    .
  eq performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V', prevVal: V'', initVal: V, AtS > PS ]
      [ microacts : resetMem(Q), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V,  prevVal: V,   initVal: V, AtS > PS ]
      [ microacts : AS ]
      )
    .
  eq performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V, prevVal: V', AtS > PS ]
      [ microacts : undoMem(Q), AS ]
      )
  =
    performAssignments(
      Conf
      [ memory : < Q : memory | actVal: V',  prevVal: V',  AtS > PS ]
      [ microacts : AS ]
      )
    .
  eq performAssignments(Conf) = Conf [owise] .



*** Activate redexes
op activateRedexes : Config -> Config .
eq activateRedexes([ nodes : < Q : CC | active: false, NA > PS ] Conf)
 = activateRedexes([ nodes : < Q : CC | active: true,  NA > PS ] Conf) .
eq activateRedexes(Conf) = Conf [owise] .

endfm
