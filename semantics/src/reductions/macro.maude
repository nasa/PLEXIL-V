fmod MACRO is
  protecting INTERFACE .

  vars AS             : ActionSet .
  vars AtS AtS'       : AttributeSet .
  vars CmdId          : Identifier .
  vars CmdIdExpr      : CommandId .
  vars St St' St''    : Config .
  vars Cfg Cfg' Cfg'' : Config .
  vars Conf Conf'     : Config .
  vars PArr PArr'     : PrimitiveArray .
  vars PS PS'         : Configuration .
  vars NeQ?           : Maybe{NeQualified} .
  vars Nds Nds'       : Configuration .
  vars Sigma          : Environment .
  vars Gamma          : Environment .
  vars CL             : EnvironmentList .
  vars Q              : Qualified .
  vars TL TL'         : TraceList .
  vars V V' V''       : Value .
  vars KConf : [Config] .
  vars EG EG' GEN : InputGenerator .
  vars Act : Operation .
  vars E : Environment .
  vars ExtInput EIn EInput : Inputs .
  vars Nodes Nodes' : Configuration .
  vars InSet : InputsSet .

  op cleanTrace : Config -> Config .
  eq cleanTrace( [ trace : T:TraceList ] Cfg ) = [ trace : niltrace ] Cfg .

  ceq [MACRO-relation] :
    macro | [ generator : EG  ] Cfg
  =
    if InSet == empty
    then
      stop  | [ generator : EG ] Cfg
    else
      NDChoice(InSet) | cleanTrace([ generator : EG ] Cfg)
    fi
    if InSet := generate(EG, [ generator : EG ] Cfg)
  .

  op macro-log : -> Operation .
  eq [MACRO-relation-log] : macro-log = micro [print "MACRO"] .

  ceq [quiescence] :
    quiescence | Cfg
  =
    macro |
      executeUpdates(
        executeCommands(
          unSuspendMacroNodes(
            Cfg
          )
        )
      )
  if Cfg' := incrementCycleCount(Cfg)
  /\ N := getCycleCount(Cfg')
  .

  op executeCommandsDebug : Config -> Config .
  eq executeCommandsDebug([ macroacts : AS ] Conf)
   = executeCommands(     [ macroacts : AS ] Conf)
  [print "MACTIONS: " AS]
  .

  **************************************************
  *** Utility functions                          ***
  **************************************************

  op hasCommandToExecute? : Config -> Bool .
  eq hasCommandToExecute?(St) = false .

  vars NId : Identifier .
  vars Value Value' : Value .
  vars Args : Arguments .
  vars CmdInfo : CommandInfo .
  vars Pretty? : Bool .

  op base10 : -> NzNat .
  eq base10 = 10 .

  op value-formatter : Value -> String .
  eq value-formatter(val(I:Int)) = string(I:Int,base10) .
  eq value-formatter(val(S:String)) = S:String .
  eq value-formatter(val(F:Float)) = string(F:Float) .
  eq value-formatter(val(B:Bool)) = if B:Bool then "true" else "false" fi .
  eq value-formatter(unknown) = "<unknown>" .

  op string-formatter : Arguments Bool -> String .
  eq string-formatter(Value Args, Pretty?) = value-formatter(Value)
                                           + if Pretty? then " " else "" fi
                                           + string-formatter(Args,Pretty?) .
  eq string-formatter(nilarg, Pretty?) = if Pretty? then "\n" else "" fi .

  vars MEM : Configuration .
  var Cmds : Configuration .
  vars Q' Q'' : Qualified .
  vars Params : Parameters .
  vars AtS'' : AttributeSet .
  var Intf : Config .
  vars PAIRS : List{Pair{Qid,Expression}} .

  op executeUpdates : Config ~> Config .
  eq executeUpdates(
      [ macroacts : runUpdate(Q,PAIRS), AS ]
      [ interface : < Q : C:Cid | AtS > Nds ]
      Cfg
      )
    =
      ERROR(
        executeUpdates(
          [ macroacts : runUpdate(Q,PAIRS), AS ]
          [ interface : < Q : C:Cid | AtS > Nds ]
          Cfg
        )
      )
  .
  eq executeUpdates(
      [ macroacts : runUpdate(Q,PAIRS), AS ]
      [ interface : Nds ]
      Cfg
      )
    =
      [ macroacts :                     AS ]
      [ interface : Nds < Q : update-on-execution | ack: false, pairs: PAIRS > ]
      Cfg
  [owise]
  .
  eq executeUpdates(
      [ macroacts : AS  ]
      [ interface : Nds ]
      Cfg
      )
    =
      [ macroacts : AS  ]
      [ interface : Nds ]
      Cfg
  [owise]
  .

  op executeCommands : Config -> Config .
  eq executeCommands(
       [ nodes : < Q : command | AtS > Nds ]
       [ macroacts : abortCommand(Q), AS ]
       [ interface : < CmdId . Q : command-on-execution | abort: CommandAbortIdle, AtS' > Cmds ]
       Conf )
     =
     executeCommands(
       [ nodes : < Q : command | AtS > Nds ]
       [ macroacts : AS ]
       [ interface : < CmdId . Q : command-on-execution | abort: CommandAbortInvoked, AtS' > Cmds ]
       Conf
     )
  .
 ceq executeCommands(
       [ nodes : < Q : command | AtS > Nds ]
       [ macroacts : runCommand(Q, cmdInvocation(CmdId,Args)), AS ]
       [ interface : Cmds ]
       Conf )
   =
     executeCommands(
       [ nodes : < Q : command | AtS > Nds ]
       [ macroacts : AS ]
       [ interface :
        < CmdId . Q : command-on-execution |
          arguments: Args,
          returnVariable: nothing,
          handle: just(CommandSuccess),
          abort: CommandAbortIdle,
          order: (getLatestRunningCommandNumber(Cmds,CmdId,Args,0) + 1) > Cmds ]
       Conf
     )
  if ((CmdId == 'pprint) or (CmdId == 'print))
  /\ Str:String := string-formatter(Args,if CmdId == 'pprint then true else false fi)
  .
  eq executeCommands(
       [ nodes : < Q : command | command: CmdIdExpr / Params / NeQ?, AtS > Nds ]
       [ macroacts : runCommand(Q, cmdInvocation(CmdId,Args)), AS ]
       [ interface : < CmdId . Q' : command-on-execution | arguments: Args, AtS' > Cmds ]
       Conf )
   =
    executeCommands(
      [ nodes : < Q : command | command: CmdIdExpr / Params / NeQ?, AtS > Nds ]
      [ macroacts : AS ]
      [ interface :
        < CmdId . Q : command-on-execution |
          arguments: Args,
          returnVariable: NeQ?,
          handle: nothing,
          abort: CommandAbortIdle,
          order: (getLatestRunningCommandNumber(
            < CmdId . Q' : command-on-execution | AtS' > Cmds,
            CmdId,
            Args,
            0) + 1
          ) >
        < CmdId . Q' : command-on-execution | AtS' > Cmds ]
      Conf
    )
  [owise]
  .
  eq executeCommands(
       [ nodes : < Q : command | command: CmdIdExpr / Params / NeQ?, AtS > Nds ]
       [ macroacts : runCommand(Q, cmdInvocation(CmdId,Args)), AS ]
       [ interface : Cmds ]
       Conf )
   =
    executeCommands(
      [ nodes : < Q : command | command: CmdIdExpr / Params / NeQ?, AtS > Nds ]
      [ macroacts : AS ]
      [ interface :
        < CmdId . Q : command-on-execution |
          arguments: Args,
          returnVariable: NeQ?,
          handle: nothing,
          abort: CommandAbortIdle,
          order: 0 > Cmds ]
      Conf
    )
  [owise]
  .
  eq executeCommands([ macroacts : AS ] Conf) = [ macroacts : AS ] Conf [owise] .

  op unSuspendMacroNodes : Config -> Config .
  eq unSuspendMacroNodes(
      Conf
      [ nodes : < Q : assignment | suspended: true, AtS > PS ]
      )
  =
    unSuspendMacroNodes(
      Conf
      [ nodes : < Q : assignment | suspended: false, AtS > PS ]
      )
    .
  eq unSuspendMacroNodes(
      Conf
      [ nodes : < Q : command | suspended: true, AtS > PS ]
      )
  =
    unSuspendMacroNodes(
      Conf
      [ nodes : < Q : command | suspended: false, AtS > PS ]
      )
    .
  eq unSuspendMacroNodes(
      Conf
      [ nodes : < Q : update | suspended: true, AtS > PS ]
      )
  =
    unSuspendMacroNodes(
      Conf
      [ nodes : < Q : update | suspended: false, AtS > PS ]
      )
    .
  eq unSuspendMacroNodes(Conf) = Conf [owise] .

 op counter : -> Cid .
 var N : Nat .
 var IFACE : Configuration .

  op incrementCycleCount : Config -> Config .
  eq incrementCycleCount([ interface : < 'cycle : counter | value: N, AtS > IFACE ] Conf)
  = [ interface : < 'cycle : counter | value: s N, AtS > IFACE ] Conf .
  eq incrementCycleCount([ interface : IFACE ] Conf)
  = [interface : < 'cycle : counter | value: 1 > IFACE ] Conf [owise] .

  op getCycleCount : Config -> Nat .
  eq getCycleCount([ interface : < 'cycle : counter | value: N, AtS > IFACE ] Conf) = N .
  eq getCycleCount([ interface : IFACE ] Conf) = 0 [owise] .
endfm
