***( GENERATORS--SEQUENCE

  Implements a finite sequential generator that plays back a predetermined list of
  inputs in order, consuming one element per step until the list is exhausted.

  KEY DESIGN DECISIONS:

    - **Deterministic playback**: Each call to 'generate' returns only the next input
      in the sequence (not a set of choices), making this generator fully deterministic.

    - **Stateless update**: The 'update' operation ignores the actual input chosen
      (since there's only one choice) and simply advances to the next element in the list.

    - **Finite cardinality**: The generator is consumed after 'length(list)' steps,
      with exactly 1 input option per step.

  ENTRY POINTS:

    - 'sequence(inputList)' - constructs a sequential generator from a list of inputs

  IMPORTANT BEHAVIORS:

    - **Empty list handling**: When the input list is empty ('nilEInputsList'), the
      generator produces 'empty' (not 'noInputs'), signaling termination to the model
      checker.

    - **Consumption**: The generator is consumed (returns true for 'isConsumed?') only
      when the entire list has been exhausted.

)***

fmod GENERATORS--SEQUENCE is
  pr SYSTEM .
  pr INPUTS-LIST .

  op sequence : EInputsList -> InputGenerator [ctor] .

  eq generate(sequence(nilEInputsList),Cfg) = empty .
  eq generate(sequence(In # InL),Cfg) = In .

  eq update(sequence(nilEInputsList),Cfg,In) = sequence(nilEInputsList) .
  eq update(sequence(In # InL),Cfg,In') = sequence(InL) .

  eq cardinality(sequence(IL:EInputsList)) = Cardinality(countPerStep : 1, numberOfSteps : length(IL:EInputsList)) .

  eq isConsumed?(sequence(nilEInputsList), Cfg) = true .
  eq isConsumed?(sequence(In # InL), Cfg) = false .

  vars Cfg : Config .
  vars In In' : Inputs .
  vars InL : EInputsList .
endfm
