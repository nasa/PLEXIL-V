***( GENERATORS--INPUTS-FILTER

  Implements a generator that filters individual inputs from a generated input set
  based on a boolean expression, removing inputs that don't satisfy the condition.

  KEY DESIGN DECISIONS:

    - **Per-input filtering**: Unlike 'filter' (which filters entire generation steps),
      'inputs-filter' evaluates the expression for each individual input in the set and
      removes those that don't satisfy the condition.

    - **Lookup wrapping**: Before evaluating the filter expression, lookup inputs are
      wrapped with 'new(...)' via 'wrapWithNew', ensuring they are treated as fresh
      values in the expression evaluation context.

    - **Environment-based evaluation**: The filter expression is evaluated in a temporary
      environment updated with the candidate input's lookups, allowing the expression
      to reference lookup values.

    - **Fallback to noInputs**: If all inputs are filtered out (result is 'empty'), the
      generator produces 'noInputs' instead, preventing termination and allowing the
      system to progress without inputs.

  ENTRY POINTS:

    - 'inputs-filter(Gen, Expr)' - constructs an input-filtering generator

  IMPORTANT BEHAVIORS:

    - **Two-level filtering**: The 'filter-inputs-set' operator iterates through the
      input set, accumulating inputs that satisfy the expression (evaluate to 'true').

    - **Expression evaluation context**: Each input is evaluated by:
      1. Extracting lookups from the input
      2. Wrapping them with 'new(...)' markers
      3. Updating a temporary environment with these lookups
      4. Evaluating the expression in this environment
      5. Including the input if the result is 'const(val(true))'

    - **Cardinality preservation**: The cardinality matches the embedded generator,
      as the filter doesn't change the number of generation steps.

)***

fmod GENERATORS--INPUTS-FILTER is
  protecting SYSTEM .
  protecting EVAL .
  protecting INTERFACE .

  op inputs-filter : InputGenerator Expression -> InputGenerator [ctor] .
  ceq generate(inputs-filter(Gen,Expr),Cfg)
    = if FilteredInS == empty then noInputs else FilteredInS fi
  if InS := generate(Gen,Cfg)
  /\ FilteredInS := filter-inputs-set(InS,Expr,Cfg)
  .

  op filter-inputs-set : InputsSet Expression Config ~> InputsSet .
  eq filter-inputs-set(InS,Expr,Cfg) = filter-inputs-set'(InS,Expr,Cfg,empty) .

    op filter-inputs-set' : InputsSet Expression Config InputsSet ~> InputsSet .
   ceq filter-inputs-set'((In, InS),Expr,Cfg, InS') =
      if Result == const(val(true)) then
        filter-inputs-set'(InS,Expr,Cfg,(In,InS'))
      else
        filter-inputs-set'(InS,Expr,Cfg,InS')
      fi
    if In' := wrapWithNew(getLookups(In))
    /\ Env := updateInternalEnvironment(getEnvironment(Cfg), In',mtenvironment)
    /\ Nds := getNodes(Cfg)
    /\ Result := eval(Env,Nds,Expr)
    .
    eq filter-inputs-set'(empty,Expr,Cfg,InS') = InS' [owise] .


  op wrapWithNew : Inputs -> Inputs .
  eq wrapWithNew(StI In) = new(StI) wrapWithNew(In) .
  eq wrapWithNew(In) = In [owise] .

  eq update(inputs-filter(Gen,Expr),Cfg,In) = inputs-filter(update(Gen,Cfg,In),Expr) .

  eq cardinality(inputs-filter(Gen,Expr)) = cardinality(Gen) .

  vars Nds : Configuration .
  vars Cfg : Config .
  vars Expr Result : Expression .
  vars Env : Environment .
  vars Gen  : InputGenerator .
  vars StI : StateInput .
  vars In In' : Inputs .
  vars InS InS' FilteredInS : InputsSet .
endfm
