***( GENERATORS--INTERFACE

  Provides the minimal public interface for the generator library, exposing only
  some basic generators.

)***

sload generator.maude
sload base-generator.maude
sload zero.maude
sload empty.maude

fmod GENERATORS--INTERFACE is
  pr GENERATORS--ZERO .
  pr GENERATORS--EMPTY .
  pr INPUTS-LIST .
endfm
