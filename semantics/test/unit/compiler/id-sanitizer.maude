mod TEST--COMPILER--ID-SANITIZER is

pr TEST-BASE .

op test--compiler--id-sanitizer : -> TestResults .
eq test--compiler--id-sanitizer =
    test--id-sanitizer--on-expressions
    + test--id-sanitizer--on-pairs
    + test--id-sanitizer--on-attributes
    + test--id-sanitizer--on-memory
    + test--id-sanitizer--on-cache-attrs
    + test--collectLookupCaches--with-context
    + test--getFullyQualifiedVariableId
    + test--getFullyQualifiedNodeId
    .

vars Cfg      : Configuration .
vars I I'     : Identifier .
vars V W      : Identifier .
vars E E'     : Expression .
vars Q Q' Q'' : NeQualified .
vars QV QW    : NeQualified .

op test--id-sanitizer--on-attributes : -> TestResults .
ceq test--id-sanitizer--on-attributes =
begin tests

    assert "repeatc: attribute is sanitized" from
        testAttributes( sanitizeIds(
            repeatc: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            repeatc: E'
        )
    end

    assert "startc: attribute is sanitized" from
        testAttributes( sanitizeIds(
            startc: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            startc: E'
        )
    end

    assert "endc: attribute is sanitized" from
        testAttributes( sanitizeIds(
            endc: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            endc: E'
        )
    end

    assert "exitc: attribute is sanitized" from
        testAttributes( sanitizeIds(
            exitc: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            exitc: E'
        )
    end

    assert "post: attribute is sanitized" from
        testAttributes( sanitizeIds(
            post: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            post: E'
        )
    end

    assert "skip: attribute is sanitized" from
        testAttributes( sanitizeIds(
            skip: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            skip: E'
        )
    end

    assert "pre: attribute is sanitized" from
        testAttributes( sanitizeIds(
            pre: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            pre: E'
        )
    end

    assert "inv: attribute is sanitized" from
        testAttributes( sanitizeIds(
            inv: E,
            Q,
            Cfg
            )
        )
        reaches
        testAttributes(
            inv: E'
        )
    end

    assert "pairs:_ attribute is sanitized" from
      anAttributeSet(
        sanitizeIds(
          pairs:
            < 'field1 ; var(A) >
            < 'field2 ; arrayVar(B) >,
          C,
          < A . C : memory | none >
          < B . C : memory | none >
        )
      )
    reaches
      anAttributeSet(
        pairs:
            < 'field1 ; var(A . C) >
            < 'field2 ; arrayVar(B . C) >
      )
    end

    assert "endc:_ attribute with isFinished? with no siblings is sanitized" from
      anAttributeSet(
        sanitizeIdsOnAttr(
          endc: isFinished?('A),
          'B,
          < 'B : list | none >
          < 'A . 'B : command | none >)
      )
    reaches
      anAttributeSet(
        endc: isFinished?('A . 'B)
      )
    end

end tests
if
    Cfg :=  < 'C . 'B . 'A : list | none >
            <      'B . 'A : list | none >
            <           'A : list | none >
    /\ I  := 'B
    /\ E  := isStatus?(I,waiting)
    /\ Q  := 'C . 'A
    /\ Q' := 'B . 'A
    /\ E' := isStatus?(getFullyQualifiedNodeId(I,Q,Cfg),waiting)
.

op test--id-sanitizer--on-pairs : -> TestResults .
eq test--id-sanitizer--on-pairs =
begin tests
  assert "sanitize ids on no pairs " from
    somePairs(
      sanitizeIdsOnPairs(
        nil,
        C,
        none
      )
    )
  reaches
    somePairs(
      nil
    )
  end

  assert "sanitize ids on pairs " from
    somePairs(
      sanitizeIdsOnPairs(
        < 'field1 ; var(A) >
        < 'field2 ; arrayVar(B) >
        < 'field3 ; arrayVar(B,const(val(0))) >,
        C,
        < A . C : memory | none >
        < B . C : memory | none >
      )
    )
  reaches
    somePairs(
      < 'field1 ; var(A . C) >
      < 'field2 ; arrayVar(B . C) >
      < 'field3 ; arrayVar(B . C,const(val(0))) >
    )
  end
end tests
.


op test--id-sanitizer--on-expressions : -> TestResults .
ceq test--id-sanitizer--on-expressions =
begin tests

    assert "An `isFailure?` expression computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                isFailure?(I, parentExited),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            isFailure?(Q', parentExited)
        )
    end

    assert "An `isStatus?` expression computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                isStatus?(I, waiting),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            isStatus?(Q', waiting)
        )
    end

    assert "An `isOutcome?` expression computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                isOutcome?(I,success),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            isOutcome?(Q',success)
        )
    end

    assert "An `isOutcomeFailure?` expression computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                isOutcomeFailure?(I),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            isOutcomeFailure?(Q')
        )
    end

    assert "An `areChildren?` expression computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                areChildren?(I, waiting),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            areChildren?(Q', waiting)
        )
    end

    assert "An `_and_` expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                isStatus?(I, waiting) and isStatus?(I', inactive),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            isStatus?(Q', waiting)
            and
            isStatus?(Q'', inactive)
        )
    end

    assert "An `_or_` expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                isStatus?(I, waiting) or isStatus?(I', inactive),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            isStatus?(Q', waiting)
            or
            isStatus?(Q'', inactive)
        )
    end

    assert "An `not_` expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                not isStatus?(I, waiting),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            not isStatus?(Q', waiting)
        )
    end

    assert "A `var` expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                var(I),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            var(unresolvedVariable(I,Q))
        )
        testExpression(
            var(QV)
        )
    end

    assert "A comparison expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                var(V) < var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) <= var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) > var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) >= var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) nequ var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) equ var(W),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            var(QV) < var(QW)
        )
        testExpression(
            var(QV) <= var(QW)
        )
        testExpression(
            var(QV) > var(QW)
        )
        testExpression(
            var(QV) >= var(QW)
        )
        testExpression(
            var(QV) equ var(QW)
        )
        testExpression(
            var(QV) nequ var(QW)
        )
    end

    assert "A `func` expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                func(absp,var(V)),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            func(absp,var(QV))
        )
    end

    assert "An `isKnown` expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                isKnown(var(V)),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            isKnown(var(QV))
        )
    end

    assert "An `arrayVar` expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                arrayVar(V,var(W)),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            arrayVar(QV,var(QW))
        )
    end

    assert "A arithmetic expression propagates the sanitization" from
        testExpression(
            sanitizeIds(
                var(V) + var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) - var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) * var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) / var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) max var(W),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                var(V) min var(W),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            var(QV) + var(QW)
        )
        testExpression(
            var(QV) - var(QW)
        )
        testExpression(
            var(QV) * var(QW)
        )
        testExpression(
            var(QV) / var(QW)
        )
        testExpression(
            var(QV) max var(QW)
        )
        testExpression(
            var(QV) min var(QW)
        )
    end

    assert "A `const` expression returns itself" from
        testExpression(
            sanitizeIds(
                const(val(1)),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            const(val(1))
        )
    end

    assert "A `lookup` expression returns itself" from
        testExpression(
            sanitizeIds(
                lookup(I,nilpar),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                lookup('state,nilpar),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            lookup('state,nilpar)
        )
        testExpression(
            lookup(I,nilpar)
        )
    end

    assert "A `lookup` expression with parameters propagates the sanitization" from
        testExpression(
            sanitizeIds(
                lookup('state,var(V)),
                Q,
                Cfg
            )
        )
        testExpression(
            sanitizeIds(
                lookupOnChange('state,var(V),val(1)),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            lookup('state,var(QV))
        )
        testExpression(
            lookupOnChange('state,var(QV),val(1))
        )
    end

    assert "A `lookup` expression with values are considered errors for sanitization" from
        testExpression(
            sanitizeIds(
                lookup('state,nilarg),
                'Q,
                none
            )
        )
        testExpression(
            sanitizeIds(
                lookupOnChange('state,val(1),val(1)),
                'Q,
                Cfg
            )
        )
        reaches
        testExpression(
            ERROR{sanitizeIds.Expression: lookup('state, nilarg)}
        )
        testExpression(
            ERROR{sanitizeIds.Expression: lookupOnChange('state,val(1),val(1))}
        )
    end

    assert "A `lookupOnChange` with embedded cache ID sanitizes args but preserves cache ID" from
        testExpression(
            sanitizeIds(
                lookupOnChange(5, 'state, var(V), val(1)),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            lookupOnChange(5, 'state, var(QV), val(1))
        )
    end

    assert "A `lookupOnChange` with variable stateName and embedded cache ID sanitizes both" from
        testExpression(
            sanitizeIds(
                lookupOnChange(10, var(V), var(W), val(2)),
                Q,
                Cfg
            )
        )
        reaches
        testExpression(
            lookupOnChange(10, var(QV), var(QW), val(2))
        )
    end

    assert "A `hasPostconditionFailed?` expression with qualified id computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                hasPostconditionFailed?('B),
                'B . 'A,
                < 'C . 'B . 'A : list   | none >
                <      'B . 'A : list   | none >
                <           'A : list   | none >
            )
        )
        reaches
        testExpression(
            hasPostconditionFailed?('B . 'A)
        )
    end

    assert "A `hasPostconditionFailed?` expression with sibling reference computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                hasPostconditionFailed?(sibling('C)),
                'B . 'A,
                < 'C . 'B . 'A : list   | none >
                <      'B . 'A : list   | none >
                <           'A : list   | none >
            )
        )
        reaches
        testExpression(
            hasPostconditionFailed?('C . 'A)
        )
    end

    assert "A `hasSkipped?` expression with qualified id computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                hasSkipped?('B),
                'B . 'A,
                < 'C . 'B . 'A : list   | none >
                <      'B . 'A : list   | none >
                <           'A : list   | none >
            )
        )
        reaches
        testExpression(
            hasSkipped?('B . 'A)
        )
    end

    assert "A `hasSkipped?` expression with sibling reference computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                hasSkipped?(sibling('C)),
                'B . 'A,
                < 'C . 'B . 'A : list   | none >
                <      'B . 'A : list   | none >
                <           'A : list   | none >
            )
        )
        reaches
        testExpression(
            hasSkipped?('C . 'A)
        )
    end

    assert "A `hasIterationEnded?` expression with qualified id computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                hasIterationEnded?('B),
                'B . 'A,
                < 'C . 'B . 'A : list   | none >
                <      'B . 'A : list   | none >
                <           'A : list   | none >
            )
        )
        reaches
        testExpression(
            hasIterationEnded?('B . 'A)
        )
    end

    assert "A `hasIterationEnded?` expression with sibling reference computes its fully qualified node id" from
        testExpression(
            sanitizeIds(
                hasIterationEnded?(sibling('C)),
                'B . 'A,
                < 'C . 'B . 'A : list   | none >
                <      'B . 'A : list   | none >
                <           'A : list   | none >
            )
        )
        reaches
        testExpression(
            hasIterationEnded?('C . 'A)
        )
    end

end tests
if
    Cfg :=  < 'C . 'B . 'A : list   | none >
            <      'B . 'A : list   | none >
            <           'A : list   | none >
            <      'V . 'A : memory | none >
            < 'W . 'B . 'A : memory | none >
    /\ I   := 'B
    /\ I'  := 'C
    /\ V   := 'V
    /\ W   := 'W
    /\ Q   := 'B . 'A
    /\ Q'  := 'B . 'A
    /\ Q'' := 'C . 'B . 'A
    /\ QV  := 'V . 'A
    /\ QW  := 'W . 'B . 'A
.


op test--id-sanitizer--on-memory : -> TestResults .
eq test--id-sanitizer--on-memory =
begin tests

    assert "sanitizeIdsInMemory preserves regular memory objects unchanged" from
        testConfiguration(
            sanitizeIdsInMemory(
                < 'X . 'A : memory | initVal: val(1), actVal: val(1), prevVal: val(1) >,
                < 'A : list | none >
                < 'X . 'A : memory | initVal: val(1), actVal: val(1), prevVal: val(1) >
            )
        )
    reaches
        testConfiguration(
            < 'X . 'A : memory | initVal: val(1), actVal: val(1), prevVal: val(1) >
        )
    end

    assert "sanitizeIdsInMemory sanitizes cache args with simple variable reference" from
        testConfiguration(
            sanitizeIdsInMemory(
                < cache(0) : lookup-cache |
                    stateName: const(val("time")), prevStateName: unknown,
                    args: var('X),
                    prevArgs: nilarg,
                    tolerance: val(1),
                    cachedValue: unknown,
                    nodeContext: 'Child . 'Root >,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'X . 'Child . 'Root : memory | none >
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("time")), prevStateName: unknown,
                args: var('X . 'Child . 'Root),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
        )
    end

    assert "sanitizeIdsInMemory sanitizes cache args with nilpar" from
        testConfiguration(
            sanitizeIdsInMemory(
                < cache(0) : lookup-cache |
                    stateName: const(val("time")), prevStateName: unknown,
                    args: nilpar,
                    prevArgs: nilarg,
                    tolerance: val(1),
                    cachedValue: unknown,
                    nodeContext: 'Child . 'Root >,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("time")), prevStateName: unknown,
                args: nilpar,
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
        )
    end

    assert "sanitizeIdsInMemory sanitizes cache args with multiple parameters" from
        testConfiguration(
            sanitizeIdsInMemory(
                < cache(0) : lookup-cache |
                    stateName: const(val("state")), prevStateName: unknown,
                    args: var('X) var('Y),
                    prevArgs: nilarg,
                    tolerance: val(1),
                    cachedValue: unknown,
                    nodeContext: 'Child . 'Root >,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'X . 'Child . 'Root : memory | none >
                < 'Y . 'Root : memory | none >
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("state")), prevStateName: unknown,
                args: var('X . 'Child . 'Root) var('Y . 'Root),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
        )
    end

    assert "sanitizeIdsInMemory handles multiple cache objects" from
        testConfiguration(
            sanitizeIdsInMemory(
                < cache(0) : lookup-cache |
                    stateName: const(val("time")), prevStateName: unknown,
                    args: var('X),
                    prevArgs: nilarg,
                    tolerance: val(1),
                    cachedValue: unknown,
                    nodeContext: 'Child1 . 'Root >
                < cache(1) : lookup-cache |
                    stateName: const(val("time")), prevStateName: unknown,
                    args: var('Y),
                    prevArgs: nilarg,
                    tolerance: val(1),
                    cachedValue: unknown,
                    nodeContext: 'Child2 . 'Root >,
                < 'Root : list | none >
                < 'Child1 . 'Root : command | none >
                < 'Child2 . 'Root : command | none >
                < 'X . 'Child1 . 'Root : memory | none >
                < 'Y . 'Child2 . 'Root : memory | none >
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("time")), prevStateName: unknown,
                args: var('X . 'Child1 . 'Root),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child1 . 'Root >
            < cache(1) : lookup-cache |
                stateName: const(val("time")), prevStateName: unknown,
                args: var('Y . 'Child2 . 'Root),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child2 . 'Root >
        )
    end

    assert "sanitizeIdsInMemory handles cache objects mixed with memory objects" from
        testConfiguration(
            sanitizeIdsInMemory(
                < 'Z . 'Root : memory | initVal: val(0), actVal: val(0), prevVal: val(0) >
                < cache(0) : lookup-cache |
                    stateName: const(val("time")), prevStateName: unknown,
                    args: var('X),
                    prevArgs: nilarg,
                    tolerance: val(1),
                    cachedValue: unknown,
                    nodeContext: 'Child . 'Root >
                < 'W . 'Child . 'Root : memory | initVal: val(1), actVal: val(1), prevVal: val(1) >,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'X . 'Child . 'Root : memory | none >
                < 'Z . 'Root : memory | initVal: val(0), actVal: val(0), prevVal: val(0) >
                < 'W . 'Child . 'Root : memory | initVal: val(1), actVal: val(1), prevVal: val(1) >
            )
        )
    reaches
        testConfiguration(
            < 'Z . 'Root : memory | initVal: val(0), actVal: val(0), prevVal: val(0) >
            < cache(0) : lookup-cache |
                stateName: const(val("time")), prevStateName: unknown,
                args: var('X . 'Child . 'Root),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
            < 'W . 'Child . 'Root : memory | initVal: val(1), actVal: val(1), prevVal: val(1) >
        )
    end

end tests
.

op test--id-sanitizer--on-cache-attrs : -> TestResults .
eq test--id-sanitizer--on-cache-attrs =
begin tests

    assert "sanitizeIdsInCacheAttrs sanitizes args attribute" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                args: var('X),
                'Child . 'Root,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'X . 'Child . 'Root : memory | none >
            )
        )
    reaches
        testAttributes(
            args: var('X . 'Child . 'Root)
        )
    end

    assert "sanitizeIdsInCacheAttrs preserves non-args attributes" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                stateName: const(val("time")), prevStateName: unknown,
                prevArgs: val(1),
                tolerance: val(1),
                cachedValue: unknown,
                'Child . 'Root,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
            )
        )
    reaches
        testAttributes(
            stateName: const(val("time")), prevStateName: unknown,
            prevArgs: val(1),
            tolerance: val(1),
            cachedValue: unknown
        )
    end

    assert "sanitizeIdsInCacheAttrs sanitizes args with multiple variables" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                args: var('X) var('Y),
                stateName: const(val("state")), prevStateName: unknown,
                'Child . 'Root,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'X . 'Child . 'Root : memory | none >
                < 'Y . 'Root : memory | none >
            )
        )
    reaches
        testAttributes(
            args: var('X . 'Child . 'Root) var('Y . 'Root),
            stateName: const(val("state")), prevStateName: unknown
        )
    end

    assert "sanitizeIdsInCacheAttrs handles complex expressions in args" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                args: var('X) + const(val(1)),
                'Child . 'Root,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'X . 'Child . 'Root : memory | none >
            )
        )
    reaches
        testAttributes(
            args: var('X . 'Child . 'Root) + const(val(1))
        )
    end

    assert "sanitizeIdsInCacheAttrs sanitizes stateName when it's a variable expression" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                stateName: var('lookupName),
                args: nilpar,
                'Child . 'Root,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'lookupName . 'Child . 'Root : memory | actVal: val("sensor") >
            )
        )
    reaches
        testAttributes(
            stateName: var('lookupName . 'Child . 'Root),
            args: nilpar
        )
    end

    assert "sanitizeIdsInCacheAttrs sanitizes both stateName and args" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                stateName: var('nameVar),
                args: var('argVar),
                'Node . 'Root,
                < 'Root : list | none >
                < 'Node . 'Root : command | none >
                < 'nameVar . 'Node . 'Root : memory | actVal: val("state") >
                < 'argVar . 'Node . 'Root : memory | actVal: val(10) >
            )
        )
    reaches
        testAttributes(
            stateName: var('nameVar . 'Node . 'Root),
            args: var('argVar . 'Node . 'Root)
        )
    end

    assert "sanitizeIdsInCacheAttrs handles nested lookupOnChange in args" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                args: lookupOnChange(0, 'time, nilpar, val(1)),
                'Child . 'Root,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
            )
        )
    reaches
        testAttributes(
            args: lookupOnChange(0, 'time, nilpar, val(1))
        )
    end

    assert "sanitizeIdsInCacheAttrs preserves cache ID (Nat) in nested lookupOnChange" from
        testAttributes(
            sanitizeIdsInCacheAttrs(
                args: lookupOnChange(5, 'state, var('X), val(1)),
                'Child . 'Root,
                < 'Root : list | none >
                < 'Child . 'Root : command | none >
                < 'X . 'Child . 'Root : memory | none >
            )
        )
    reaches
        testAttributes(
            args: lookupOnChange(5, 'state, var('X . 'Child . 'Root), val(1))
        )
    end

end tests
.

op test--collectLookupCaches--with-context : -> TestResults .
eq test--collectLookupCaches--with-context =
begin tests

    assert "collectLookupCaches stores nodeContext in cache object" from
        testConfiguration(
            collectLookupCaches(
                assignment('Child, nilocdecl, none,
                    var('X) := lookupOnChange('state, var('Y), val(1))),
                'Root,
                0
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("state")),
                prevStateName: unknown,
                args: var('Y),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
        )
    end

    assert "collectLookupCaches assigns sequential cache IDs with correct contexts" from
        testConfiguration(
            collectLookupCaches(
                list('Root, nilocdecl, none,
                    assignment('Child1, nilocdecl,
                        startc: lookupOnChange('state1, nilpar, val(1)),
                        var('X) := const(val(0)))
                    assignment('Child2, nilocdecl,
                        startc: lookupOnChange('state2, nilpar, val(2)),
                        var('Y) := const(val(0)))),
                nilq,
                0
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("state1")),
                prevStateName: unknown,
                args: nilpar,
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child1 . 'Root >
            < cache(1) : lookup-cache |
                stateName: const(val("state2")),
                prevStateName: unknown,
                args: nilpar,
                prevArgs: nilarg,
                tolerance: val(2),
                cachedValue: unknown,
                nodeContext: 'Child2 . 'Root >
        )
    end

    assert "collectLookupCaches handles nested nodes with correct contexts" from
        testConfiguration(
            collectLookupCaches(
                list('Root, nilocdecl, none,
                    list('Parent, nilocdecl, none,
                        assignment('Child, nilocdecl,
                            startc: lookupOnChange('state, var('Z), val(1)),
                            var('X) := const(val(0))))),
                nilq,
                0
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("state")),
                prevStateName: unknown,
                args: var('Z),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Parent . 'Root >
        )
    end

    assert "collectLookupCaches handles lookupOnChange in multiple conditions" from
        testConfiguration(
            collectLookupCaches(
                assignment('Child, nilocdecl,
                    ( startc: lookupOnChange('state1, nilpar, val(1)),
                      endc: lookupOnChange('state2, nilpar, val(2))),
                    var('X) := const(val(0))),
                'Root,
                0
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("state1")),
                prevStateName: unknown,
                args: nilpar,
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
            < cache(1) : lookup-cache |
                stateName: const(val("state2")),
                prevStateName: unknown,
                args: nilpar,
                prevArgs: nilarg,
                tolerance: val(2),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
        )
    end

    assert "collectLookupCaches handles lookupOnChange in update node pairs" from
        testConfiguration(
            collectLookupCaches(
                update('Child, nilocdecl, none,
                    < 'field1 ; lookupOnChange('state, var('X), val(1)) >
                    < 'field2 ; const(val(0)) >),
                'Root,
                0
            )
        )
    reaches
        testConfiguration(
            < cache(0) : lookup-cache |
                stateName: const(val("state")),
                prevStateName: unknown,
                args: var('X),
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'Child . 'Root >
        )
    end

    assert "collectLookupCaches correctly counts and assigns cache IDs" from
        testConfiguration(
            collectLookupCaches(
                list('Root, nilocdecl, none,
                    assignment('A, nilocdecl,
                        startc: lookupOnChange('s1, nilpar, val(1)),
                        var('X) := lookupOnChange('s2, nilpar, val(2)))),
                nilq,
                5
            )
        )
    reaches
        testConfiguration(
            < cache(5) : lookup-cache |
                stateName: const(val("s1")),
                prevStateName: unknown,
                args: nilpar,
                prevArgs: nilarg,
                tolerance: val(1),
                cachedValue: unknown,
                nodeContext: 'A . 'Root >
            < cache(6) : lookup-cache |
                stateName: const(val("s2")),
                prevStateName: unknown,
                args: nilpar,
                prevArgs: nilarg,
                tolerance: val(2),
                cachedValue: unknown,
                nodeContext: 'A . 'Root >
        )
    end

end tests
.

op test--getFullyQualifiedVariableId : -> TestResults .
ceq test--getFullyQualifiedVariableId =
begin tests

    assert "A top level identifier at the top context returns itself if it exists or `unresolvedVariable` if it doesn't" from
        testQualified(
            getFullyQualifiedVariableId(
                'M,
                nilq,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'X,
                nilq,
                Cfg:Configuration
            )
        )
        reaches
        testQualified(
            'M
        )
        testQualified(
            unresolvedVariable('X,nilq)
        )
    end

    assert "A top level identifier in a nested context returns the identifier if it exists or `unresolved` if it doesn't" from
        testQualified(
            getFullyQualifiedVariableId(
                'M,
                'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M,
                'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M,
                'C . 'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'X,
                'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'X,
                'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'X,
                'C . 'B . 'A,
                Cfg:Configuration
            )
        )
        reaches
        testQualified(
            'M
        )
        testQualified(
            'M
        )
        testQualified(
            'M
        )
        testQualified(
            unresolvedVariable('X,'A)
        )
        testQualified(
            unresolvedVariable('X,'B . 'A)
        )
        testQualified(
            unresolvedVariable('X,'C . 'B . 'A)
        )
    end

    assert "A nested identifier in a top level context returns `unresolvedVariable`" from
        testQualified(
            getFullyQualifiedVariableId(
                'M_A,
                nilq,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_B,
                nilq,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_C,
                nilq,
                Cfg:Configuration
            )
        )
        reaches
        testQualified(
            unresolvedVariable('M_A,nilq)
        )
        testQualified(
            unresolvedVariable('M_B,nilq)
        )
        testQualified(
            unresolvedVariable('M_C,nilq)
        )
    end

    assert "A nested identifier in its lexical context that exists returns the fully qualified id, otherwise `unresolved`" from
        testQualified(
            getFullyQualifiedVariableId(
                'M_C,
                'C . 'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_B,
                'C . 'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_A,
                'C . 'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_C,
                'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_B,
                'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_A,
                'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_C,
                'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_B,
                'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedVariableId(
                'M_A,
                'A,
                Cfg:Configuration
            )
        )
        reaches
        testQualified(
            'M_C . 'C . 'B . 'A
        )
        testQualified(
            'M_B . 'C . 'B . 'A
        )
        testQualified(
            'M_A . 'A
        )
        testQualified(
            unresolvedVariable('M_C,'B . 'A)
        )
        testQualified(
            'M_B . 'B . 'A
        )
        testQualified(
            'M_A . 'A
        )
        testQualified(
            unresolvedVariable('M_C,'A)
        )
        testQualified(
            unresolvedVariable('M_B,'A)
        )
        testQualified(
            'M_A . 'A
        )
    end

end tests
if Cfg:Configuration :=
    < 'A           : list       | none >
    < 'B . 'A      : command    | none >
    < 'C . 'B . 'A : assignment | none >
    < 'M                  : memory | none >
    < 'M_A . 'A           : memory | none >
    < 'M_B . 'B . 'A      : memory | none >
    < 'M_C . 'C . 'B . 'A : memory | none >
    < 'M_B . 'C . 'B . 'A : memory | none >
.

op test--getFullyQualifiedNodeId : -> TestResults .
ceq test--getFullyQualifiedNodeId =
begin tests

    assert "A top level identifier returns the identifier if it exists, otherwise `unresolvedNode`" from
        testQualified(
            getFullyQualifiedNodeId(
                'A,
                nilq,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedNodeId(
                'A,
                'C . 'B . 'A,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedNodeId(
                'X,
                nilq,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedNodeId(
                'X,
                'B . 'A,
                Cfg:Configuration
            )
        )
    reaches
        testQualified(
            'A
        )
        testQualified(
            'A
        )
        testQualified(
            unresolvedNode('X,nilq)
        )
        testQualified(
            unresolvedNode('X,'B . 'A)
        )
    end

    assert "A nested identifier in a top level context returns `unresolvedNode`" from
        testQualified(
            getFullyQualifiedNodeId(
                'B,
                nilq,
                Cfg:Configuration
            )
        )
        testQualified(
            getFullyQualifiedNodeId(
                'C,
                nilq,
                Cfg:Configuration
            )
        )
    reaches
        testQualified(
            unresolvedNode('B,nilq)
        )
        testQualified(
            unresolvedNode('C,nilq)
        )
    end

    assert "A nested identifier that coincides with its context returns the full qualified id" from
        testQualified(
            getFullyQualifiedNodeId(
                'B,
                'B . 'A,
                Cfg:Configuration
            )
        )
        reaches
        testQualified(
            'B . 'A
        )
    end

    assert "A `self` id returns its context as the full qualified id" from
        testQualified(
            getFullyQualifiedNodeId(
                self,
                'B . 'A,
                Cfg:Configuration
            )
        )
        reaches
        testQualified(
            'B . 'A
        )
    end

    assert "A duplicated fully qualified identifier of a node returns an `ambiguity`" from
        testQualified(
            getFullyQualifiedNodeId(
                'Child,
                'A,
                < 'Child . 'Child . 'A : list | none >
                < 'Child . 'Child . 'A : list | none >
            )
        )
        reaches
        testQualified(
            ambiguity('Child . 'Child . 'A,
                < 'Child . 'Child . 'A : list | none >
                < 'Child . 'Child . 'A : list | none >
            )
        )
    end

    assert "A nested identifier in its lexical context that exists returns the full qualified id, the priority is child, self, sibling, parent" from
        testQualified(
            getFullyQualifiedNodeId(
                'Child,
                'Child . 'Child . 'A,
                < 'Child . 'Child . 'Child . 'A : list | none >
                <          'Child . 'Child . 'A : list | none >
            )
        )
        testQualified(
            getFullyQualifiedNodeId(
                'Own,
                'Own . 'Own . 'A,
                <          'Own . 'Own . 'A : list | none >
                < 'Child . 'Own . 'Own . 'A : list | none >
            )
        )
        testQualified(
            getFullyQualifiedNodeId(
                'Sibling,
                'Own . 'Sibling . 'A,
                <              'Own . 'Sibling . 'A : list | none >
                <          'Sibling . 'Sibling . 'A : list | none >
                < 'Child . 'Sibling . 'Sibling . 'A : list | none >
            )
        )
        testQualified(
            getFullyQualifiedNodeId(
                'Parent,
                'Own . 'Parent . 'A,
                < 'Own . 'Parent . 'A : list | none >
                <        'Parent . 'A : list | none >
            )
        )
        reaches
        testQualified(
            'Child . 'Child . 'Child . 'A
        )
        testQualified(
            'Own . 'Own . 'A
        )
        testQualified(
            'Sibling . 'Sibling . 'A
        )
        testQualified(
            'Parent . 'A
        )
    end

end tests
if Cfg:Configuration :=
    < 'A                : list       | none >
    < 'B . 'A           : command    | none >
    < 'C . 'B . 'A      : list       | none >
    < 'M_A . 'A           : memory | none >
    < 'M_B . 'B . 'A      : memory | none >
    < 'M_C . 'C . 'B . 'A : memory | none >
.


endm
