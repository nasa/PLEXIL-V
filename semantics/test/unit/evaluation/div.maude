mod TEST--EVALUATION--DIV is

pr TEST-BASE .

vars Cfg      : Configuration .

op  test--evaluation--div : -> TestResults .
ceq test--evaluation--div =
begin tests

assert "Integer division" from
  testExpression(
    const(val(4)) / const(val(2))
  )
reaches
  testExpression(
    const(val(2))
  )
end

assert "Float division" from
  testExpression(
    const(val(6.0)) / const(val(3.0))
  )
reaches
  testExpression(
    const(val(2.0))
  )
end

assert "Float coerced division" from
  testExpression(
    const(val(10)) / const(val(2.0))
  )
  testExpression(
    const(val(10.0)) / const(val(2))
  )
reaches
  testExpression(
    const(val(5.0))
  )
  testExpression(
    const(val(5.0))
  )
end

assert "Unknown division" from
  testExpression(
    const(unknown) / const(val(3.0))
  )
  testExpression(
    const(val(6.0)) / const(unknown)
  )
reaches
  testExpression(
    const(unknown)
  )
  testExpression(
    const(unknown)
  )
end

assert "Recursive division" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      var('A) / var('B)
    )
  )
reaches
  testExpression(
    const(val(3.0))
  )
end

end tests
if Cfg := < 'A : memory | actVal: val(12.0) >
          < 'B : memory | actVal: val(4)  >
.

endm