mod TEST--EVALUATION--TRUNC is

pr TEST-BASE .

vars Cfg      : Configuration .

op  test--evaluation--trunc : -> TestResults .
ceq test--evaluation--trunc =
begin tests

assert "Integer trunc" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(val(9)))
    )
  )
reaches
  testExpression(
    const(val(9.0))
  )
end

assert "Float trunc positive" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(val(1.4)))
    )
  )
reaches
  testExpression(
    const(val(1.0))
  )
end

assert "Float trunc positive half" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(val(1.5)))
    )
  )
reaches
  testExpression(
    const(val(1.0))
  )
end

assert "Float trunc positive above half" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(val(1.6)))
    )
  )
reaches
  testExpression(
    const(val(1.0))
  )
end

assert "Float trunc negative" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(val(-1.4)))
    )
  )
reaches
  testExpression(
    const(val(-1.0))
  )
end

assert "Float trunc negative half" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(val(-1.5)))
    )
  )
reaches
  testExpression(
    const(val(-1.0))
  )
end

assert "Float trunc negative below half" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(val(-1.6)))
    )
  )
reaches
  testExpression(
    const(val(-1.0))
  )
end

assert "Unknown trunc" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, const(unknown))
    )
  )
reaches
  testExpression(
    const(unknown)
  )
end

assert "Recursive trunc" from
  testExpression(
    eval(
      mtenvironment,
      Cfg,
      func(trunc, var('A))
    )
  )
reaches
  testExpression(
    const(val(25.0))
  )
end

end tests
if Cfg := < 'A : memory | actVal: val(25.3) >
.

endm