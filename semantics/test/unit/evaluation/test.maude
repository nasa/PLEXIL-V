load add.maude
load sub.maude
load mul.maude
load div.maude
load mod.maude
load max.maude
load min.maude
load sqrt.maude
load abs.maude
load ceiling.maude
load floor.maude
load round.maude
load trunc.maude
load real_to_int.maude
load equ.maude
load lookup.maude
load node-predicates.maude

mod TEST--EVALUATION is

  pr TEST-BASE .

  --- Test submodules
  pr TEST--EVALUATION--ADD .
  pr TEST--EVALUATION--SUB .
  pr TEST--EVALUATION--MUL .
  pr TEST--EVALUATION--DIV .
  pr TEST--EVALUATION--MOD .
  pr TEST--EVALUATION--MAX .
  pr TEST--EVALUATION--MIN .
  pr TEST--EVALUATION--SQRT .
  pr TEST--EVALUATION--ABS .
  pr TEST--EVALUATION--CEILING .
  pr TEST--EVALUATION--FLOOR .
  pr TEST--EVALUATION--ROUND .
  pr TEST--EVALUATION--TRUNC .
  pr TEST--EVALUATION--REAL-TO-INT .
  pr TEST--EVALUATION--EQU .
  pr TEST--EVALUATION--LOOKUP .
  pr TEST--EVALUATION--NODE-PREDICATES .

  op test--evaluation : -> TestResults .
  eq test--evaluation =
       test--evaluation--add +
       test--evaluation--sub +
       test--evaluation--mul +
       test--evaluation--div +
       test--evaluation--mod +
       test--evaluation--max +
       test--evaluation--min +
       test--evaluation--sqrt +
       test--evaluation--abs +
       test--evaluation--ceiling +
       test--evaluation--floor +
       test--evaluation--round +
       test--evaluation--trunc +
       test--evaluation--real-to-int +
       test--evaluation--equ +
       test--evaluation--lookup +
       test--evaluation--node-predicates +

begin tests

  assert "numberOfCommandsOnExecutionWithId return 0 if there are no commands on execution" from
    testExpression(
      eval(
        mtenvironment,
        none,
        numberOfCommandsOnExecutionWithId('C)
      )
    )
  reaches
    anExpression(
      const(val(0))
    )
  end

  assert "numberOfCommandsOnExecutionWithId return the number of commands on execution with that Id as prefix" from
    testExpression(
      eval(
        mtenvironment,
        < 'C      : command-on-execution | none >
        < 'C      : command              | none >
        < 'C . 'B : list                 | none >
        < 'C . 'A : command-on-execution | none >
        < 'B . 'C : command-on-execution | none >
        ,
        numberOfCommandsOnExecutionWithId('C)
      )
    )
  reaches
    anExpression(
      const(val(2))
    )
  end

    assert "bEval over Config 1" from
      aBool(
        bEval(const(val(true)), [ nodes : none ] [ environment : mtenvironment ])
      )
    reaches
      aBool(
        true
      )
    end

    assert "bEval over Config" from
      aBool(
        bEval(const(val(false)), [ nodes : none ] [ environment : mtenvironment ])
      )
    reaches
      aBool(
        false
      )
    end

    assert "eval of arrayVar" from
      anExpression(
        eval(
            mtenvironment,
            [ < 'src . 'array8 : memory |
                    initVal: array(val(5.0) # val(6.0)),
                    actVal: array(val(5.0) # val(6.0)),
                    prevVal: array(val(5.0) # val(6.0)) > ],
            arrayVar('src . 'array8)
        )
      )
    reaches
      anExpression(
        const(array(val(5.0) # val(6.0)))
      )
    end

    assert "eval of arrayVar with expression that returns array" from
      anExpression(
        eval(
            mtenvironment,
            [ < 'src . 'array8 : memory |
                    initVal: array(val(5.0) # val(6.0)),
                    actVal: array(val(5.0) # val(6.0)),
                    prevVal: array(val(5.0) # val(6.0)) > ],
            arrayVar(var('src . 'array8), const(val(1)))
        )
      )
    reaches
      anExpression(
        const(val(6.0))
      )
    end

    assert "eval of arrayVar with lookupOnChange that returns array" from
      anExpression(
        eval(
            mtenvironment,
            [ < cache(0) : lookup-cache |
                    stateName: const(val("ArrayLookup")),
                    args: nilpar,
                    tolerance: val(0.0),
                    cachedValue: array(val(10.0) # val(20.0) # val(30.0)),
                    nodeContext: 'Root,
                    prevStateName: val("ArrayLookup"),
                    prevArgs: nilarg > ],
            arrayVar(lookupOnChange(0, 'ArrayLookup, nilpar, val(0.0)), const(val(2)))
        )
      )
    reaches
      anExpression(
        const(val(30.0))
      )
    end

    assert "eval of arrayVar when array expression evaluates to unknown" from
      anExpression(
        eval(
            mtenvironment,
            [ < 'x : memory |
                    initVal: unknown,
                    actVal: unknown,
                    prevVal: unknown > ],
            arrayVar(var('x), const(val(0)))
        )
      )
    reaches
      anExpression(
        const(unknown)
      )
    end

    assert "eval of arrayVar when index evaluates to unknown" from
      anExpression(
        eval(
            mtenvironment,
            [ < 'arr : memory |
                    initVal: array(val(1.0) # val(2.0) # val(3.0)),
                    actVal: array(val(1.0) # val(2.0) # val(3.0)),
                    prevVal: array(val(1.0) # val(2.0) # val(3.0)) >
              < 'idx : memory |
                    initVal: unknown,
                    actVal: unknown,
                    prevVal: unknown > ],
            arrayVar(var('arr), var('idx))
        )
      )
    reaches
      anExpression(
        const(unknown)
      )
    end

    assert "eval of arrayVar when both array and index are unknown" from
      anExpression(
        eval(
            mtenvironment,
            [ < 'arr : memory |
                    initVal: unknown,
                    actVal: unknown,
                    prevVal: unknown >
              < 'idx : memory |
                    initVal: unknown,
                    actVal: unknown,
                    prevVal: unknown > ],
            arrayVar(var('arr), var('idx))
        )
      )
    reaches
      anExpression(
        const(unknown)
      )
    end

    assert "eval of arrayVar with nested expression for index" from
      anExpression(
        eval(
            mtenvironment,
            [ < 'arr : memory |
                    initVal: array(val(10.0) # val(20.0) # val(30.0)),
                    actVal: array(val(10.0) # val(20.0) # val(30.0)),
                    prevVal: array(val(10.0) # val(20.0) # val(30.0)) >
              < 'i : memory |
                    initVal: val(1),
                    actVal: val(1),
                    prevVal: val(1) > ],
            arrayVar(var('arr), var('i) + const(val(1)))
        )
      )
    reaches
      anExpression(
        const(val(30.0))
      )
    end

    assert "eval of arrayVar with lookupOnChange returning unknown array" from
      anExpression(
        eval(
            mtenvironment,
            [ < cache(0) : lookup-cache |
                    stateName: const(val("UnknownLookup")),
                    args: nilpar,
                    tolerance: val(0.0),
                    cachedValue: unknown,
                    nodeContext: 'Root,
                    prevStateName: val("UnknownLookup"),
                    prevArgs: nilarg > ],
            arrayVar(lookupOnChange(0, 'UnknownLookup, nilpar, val(0.0)), const(val(0)))
        )
      )
    reaches
      anExpression(
        const(unknown)
      )
    end

end tests
.

endm