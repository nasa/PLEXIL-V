trunc0: {
    Real x = 1.4;
    Real y = 1.5;
    Real z = 1.6;
    Real a = -1.4;
    Real b = -1.5;
    Real c = -1.6;
    Real d = 0.0;
    Real e = 2.7;
    Real f = -2.7;
    Integer g = 3;
    Invariant trunc(x) == 1
      && trunc(y) == 1
      && trunc(z) == 1
      && trunc(a) == -1
      && trunc(b) == -1
      && trunc(c) == -1
      && trunc(d) == 0
      && trunc(e) == 2
      && trunc(f) == -2
      && trunc(g) == 3;
}