realToInt: {
    Real x = 1.4;
    Real y = 1.5;
    Real z = 1.6;
    Real a = -1.4;
    Real b = -1.5;
    Real c = -1.6;
    Real d = 0.0;
    Real e = 2.7;
    Real f = -2.7;
    Integer g = 3;
    Invariant real_to_int(x) == 1
      && real_to_int(y) == 1
      && real_to_int(z) == 1
      && real_to_int(a) == -1
      && real_to_int(b) == -1
      && real_to_int(c) == -1
      && real_to_int(d) == 0
      && real_to_int(e) == 2
      && real_to_int(f) == -2
      && real_to_int(g) == 3;
}